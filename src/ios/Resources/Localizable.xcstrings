        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla externa muestra %@. Este dispositivo muestra solo los controles en pantalla sobre negro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écran externe affiche %@. Cet appareil n'affiche que les commandes à l'écran sur fond noir."
          }
        },
        "it" : {
