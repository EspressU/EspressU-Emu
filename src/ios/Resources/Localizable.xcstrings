            "value" : "Se elimina la copia guardada. Si es el servidor activo, también se elimina el network_services.xml activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie enregistrée est supprimée. S'il s'agit du serveur actif, le network_services.xml actif est supprimé aussi."
