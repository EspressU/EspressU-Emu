    "Brightness boost lightens the game picture beyond your screen's maximum. Higher settings wash out dark areas." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Helligkeitsboost hellt das Spielbild über das Maximum deines Bildschirms hinaus auf. Höhere Werte lassen dunkle Bereiche ausbleichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El aumento de brillo aclara la imagen del juego por encima del máximo de tu pantalla. Los valores altos desvanecen las zonas oscuras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le boost de luminosité éclaircit l'image du jeu au-delà du maximum de votre écran. Les valeurs élevées délavent les zones sombres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il boost di luminosità schiarisce l'immagine del gioco oltre il massimo dello schermo. Valori più alti sbiadiscono le zone scure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るさブーストは、画面の最大輝度を超えてゲーム映像を明るくします。高くすると暗い部分が白っぽくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밝기 부스트는 게임 화면을 화면의 최대 밝기 이상으로 밝게 합니다. 높게 설정하면 어두운 부분이 뿌옇게 보입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helderheidsboost maakt het gamebeeld lichter dan het maximum van je scherm. Hogere instellingen laten donkere gebieden verbleken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reforço de brilho clareia a imagem do jogo além do máximo da sua tela. Valores mais altos lavam as áreas escuras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усиление яркости делает картинку игры ярче максимума вашего экрана. Более высокие значения «вымывают» тёмные участки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亮度增强会让游戏画面亮度超过屏幕的最大亮度。设置越高，暗部越发灰白。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亮度增強會讓遊戲畫面亮度超過螢幕的最大亮度。設定越高，暗部越發灰白。"
          }
        }
      }
    },
