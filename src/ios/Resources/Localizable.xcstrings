    "Compile shaders in the background" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shader im Hintergrund kompilieren"
          }
        },
        "es" : {
          "stringUnit" : {
