    },
    "\"%@\" is a learned-shader cache, not a pipeline cache. Use \"Import learned shaders\" for it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist ein Cache gelernter Shader, kein Pipeline-Cache. Nutze dafür „Gelernte Shader importieren“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» es una caché de shaders aprendidos, no una caché de pipelines. Usa «Importar shaders aprendidos» para ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est un cache de shaders appris, pas un cache de pipelines. Utilisez « Importer les shaders appris » pour lui."
