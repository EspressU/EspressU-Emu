    "Even frames at the game's own speed, never faster." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleichmäßige Frames in der Eigengeschwindigkeit des Spiels, nie schneller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotogramas regulares a la velocidad propia del juego, nunca más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images régulières à la vitesse propre du jeu, jamais plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotogrammi regolari alla velocità propria del gioco, mai più veloci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム本来の速度で均等なフレームを出し、それより速くなることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 자체 속도로 고른 프레임을 보여 주며 그보다 빨라지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelijkmatige frames op de eigen snelheid van de game, nooit sneller."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadros regulares na velocidade do próprio jogo, nunca mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ровные кадры с собственной скоростью игры, никогда не быстрее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以游戏自身的速度均匀输出帧，绝不更快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以遊戲自身的速度均勻輸出幀，絕不更快。"
          }
        }
      }
    },
    "Every control you moved or resized goes back to its default place and size." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes verschobene oder in der Größe geänderte Bedienelement kehrt an seinen Standardplatz und seine Standardgröße zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada control que movieras o cambiaras de tamaño vuelve a su lugar y tamaño por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque commande déplacée ou redimensionnée retrouve sa place et sa taille par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni controllo che hai spostato o ridimensionato torna alla posizione e alla dimensione predefinite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動またはサイズ変更したコントロールがすべて、初期の位置とサイズに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동하거나 크기를 바꾼 모든 컨트롤이 기본 위치와 크기로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke knop die je hebt verplaatst of geschaald gaat terug naar de standaardplek en -grootte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo controle que você moveu ou redimensionou volta à posição e ao tamanho padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый перемещённый или изменённый по размеру элемент возвращается на место и к размеру по умолчанию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你移动或调整过大小的每个控件都会恢复到默认位置和大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你移動或調整過大小的每個控制元件都會恢復到預設位置和大小。"
          }
        }
      }
    },
