    "The picture has stopped while the game keeps running. This goes away by itself if the picture comes back." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild ist stehen geblieben, während das Spiel weiterläuft. Das geht von selbst weg, wenn das Bild zurückkommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen se ha detenido mientras el juego sigue funcionando. Esto se resuelve solo si la imagen vuelve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'image s'est arrêtée alors que le jeu continue. Cela disparaît tout seul si l'image revient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'immagine si è fermata mentre il gioco continua a funzionare. Si risolve da solo se l'immagine torna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームは動き続けているのに映像が止まりました。映像が戻れば自然に直ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임은 계속 실행되는데 화면이 멈췄습니다. 화면이 돌아오면 저절로 해결됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het beeld is gestopt terwijl de game blijft draaien. Dit gaat vanzelf weg als het beeld terugkomt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A imagem parou enquanto o jogo continua rodando. Isso passa sozinho se a imagem voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картинка остановилась, пока игра продолжает работать. Это пройдёт само, если картинка вернётся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏仍在运行，但画面已停止。如果画面恢复，此问题会自行消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊戲仍在執行，但畫面已停止。如果畫面恢復，此問題會自行消失。"
          }
        }
      }
    },
    "The recompiler is off in Settings, so the %@ interpreter is running. Cores: %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Recompiler ist in den Einstellungen aus, deshalb läuft der %1$@-Interpreter. Kerne: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
