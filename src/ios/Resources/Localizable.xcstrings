    "Servers can't be changed while a game is running. Close the game first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server lassen sich nicht ändern, solange ein Spiel läuft. Beende zuerst das Spiel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores no se pueden cambiar mientras hay un juego en ejecución. Cierra el juego primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs ne peuvent pas être modifiés pendant qu'un jeu tourne. Fermez d'abord le jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I server non si possono cambiare mentre un gioco è in esecuzione. Chiudi prima il gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームの実行中はサーバを変更できません。先にゲームを閉じてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임이 실행 중일 때는 서버를 변경할 수 없습니다. 먼저 게임을 종료하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servers kunnen niet worden gewijzigd terwijl een game draait. Sluit eerst de game."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os servidores não podem ser alterados enquanto um jogo está rodando. Feche o jogo primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серверы нельзя менять, пока идёт игра. Сначала закройте игру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏运行时无法更改服务器。请先关闭游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊戲執行時無法更改伺服器。請先關閉遊戲。"
          }
        }
      }
    },
