    "Your custom cover will be deleted. The game goes back to its automatic cover, or the placeholder." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein eigenes Cover wird gelöscht. Das Spiel kehrt zum automatischen Cover oder zum Platzhalter zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará tu carátula personalizada. El juego vuelve a su carátula automática o al marcador de posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre pochette personnalisée sera supprimée. Le jeu revient à sa pochette automatique, ou à l'image de remplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua copertina personalizzata verrà eliminata. Il gioco torna alla copertina automatica o al segnaposto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムカバーは削除されます。ゲームは自動カバー、またはプレースホルダに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 커버가 삭제됩니다. 게임이 자동 커버 또는 자리 표시자로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je eigen cover wordt verwijderd. De game gaat terug naar zijn automatische cover of de plaatshouder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua capa personalizada será apagada. O jogo volta à capa automática ou ao marcador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша обложка будет удалена. Игра вернётся к автоматической обложке или заглушке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的自定义封面将被删除。游戏会恢复为自动封面或占位图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的自訂封面將被刪除。遊戲會恢復為自動封面或預留位置圖。"
          }
        }
      }
    },
