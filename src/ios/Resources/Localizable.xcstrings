    "EspressU can't read \"%@\". If it's on a drive, make sure the drive is connected." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU kann „%@“ nicht lesen. Wenn es auf einem Laufwerk liegt, stelle sicher, dass es verbunden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU no puede leer «%@». Si está en una unidad, asegúrate de que esté conectada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU ne peut pas lire « %@ ». S'il est sur un disque, assurez-vous que le disque est connecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU non riesce a leggere «%@». Se è su un'unità, assicurati che sia connessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU は「%@」を読み取れません。ドライブにある場合は、ドライブが接続されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU가 \"%@\"을(를) 읽을 수 없습니다. 드라이브에 있다면 드라이브가 연결되어 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU kan «%@» niet lezen. Als het op een schijf staat, controleer dan of de schijf is aangesloten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O EspressU não consegue ler «%@». Se estiver em uma unidade, confira se ela está conectada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU не может прочитать «%@». Если он на диске, убедитесь, что диск подключён."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU 无法读取“%@”。如果它在驱动器上，请确认驱动器已连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU 無法讀取「%@」。如果它在驅動器上，請確認驅動器已連線。"
          }
        }
      }
    },
    "EspressU can't use your %@'s microphone until you allow it in iOS Settings. Until then, games use the Blow button in the top bar instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU kann das Mikrofon deines Geräts (%@) nicht nutzen, bis du es in den iOS-Einstellungen erlaubst. Bis dahin nutzen Spiele stattdessen den Pusten-Knopf in der oberen Leiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU no puede usar el micrófono de tu %@ hasta que lo permitas en los Ajustes de iOS. Hasta entonces, los juegos usan el botón Soplar de la barra superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU ne peut pas utiliser le micro de votre %@ tant que vous ne l'autorisez pas dans les Réglages iOS. D'ici là, les jeux utilisent le bouton Souffler de la barre du haut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
