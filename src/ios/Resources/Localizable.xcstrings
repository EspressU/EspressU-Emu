    "Most games take a Pro Controller; some older ones want the Classic Controller." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Spiele nehmen einen Pro Controller; manche ältere wollen den Classic Controller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de los juegos usan un Pro Controller; algunos más antiguos piden el Classic Controller."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des jeux utilisent une Pro Controller ; certains plus anciens veulent la Classic Controller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte dei giochi usa un Pro Controller; alcuni più vecchi richiedono il Classic Controller."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほとんどのゲームはProコントローラを使います。古いゲームの一部はクラシックコントローラを必要とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 게임은 Pro 컨트롤러를 사용하며, 일부 오래된 게임은 클래식 컨트롤러가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
