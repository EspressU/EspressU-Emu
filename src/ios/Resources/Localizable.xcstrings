    "Plays EspressU's themes, or your own tracks, on loop in the menus, never in a game." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Themen von EspressU oder deine eigenen Titel in Dauerschleife in den Menüs, nie in einem Spiel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce los temas de EspressU, o tus propias pistas, en bucle en los menús, nunca durante un juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue en boucle les thèmes d'EspressU, ou vos propres morceaux, dans les menus, jamais en jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce in loop i temi di EspressU, o i tuoi brani, nei menu, mai durante un gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューでEspressUのテーマ曲またはお好みの曲をループ再生します。ゲーム中は再生しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴에서 EspressU 테마나 내 트랙을 반복 재생합니다. 게임 중에는 재생하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt de thema's van EspressU, of je eigen nummers, in een lus in de menu's, nooit tijdens een game."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca os temas do EspressU, ou suas próprias faixas, em loop nos menus, nunca durante um jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зациклено воспроизводит темы EspressU или ваши треки в меню, но никогда в игре."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单中循环播放 EspressU 的主题曲或你自己的曲目，游戏中不会播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單中循環播放 EspressU 的主題曲或你自己的曲目，遊戲中不會播放。"
          }
        }
      }
    },
