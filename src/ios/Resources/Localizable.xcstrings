    "Names the folder your saves live in. Leave it alone unless you're importing saves from a real Wii U." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benennt den Ordner, in dem deine Spielstände liegen. Lass es, wie es ist, außer du importierst Spielstände von einer echten Wii U."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el nombre de la carpeta donde viven tus partidas guardadas. No lo toques salvo que importes partidas de una Wii U real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomme le dossier où vivent vos sauvegardes. N'y touchez pas sauf si vous importez des sauvegardes d'une vraie Wii U."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica il nome della cartella in cui risiedono i tuoi salvataggi. Non toccarlo, a meno che tu non importi salvataggi da un vero Wii U."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セーブデータを置くフォルダの名前です。実際のWii Uからセーブデータを読み込むとき以外は、変更しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장 데이터가 있는 폴더의 이름을 지정합니다. 실제 Wii U에서 저장 데이터를 가져오는 경우가 아니면 그대로 두세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft de naam van de map waar je opgeslagen games staan. Laat dit met rust, tenzij je opgeslagen games van een echte Wii U importeert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dá nome à pasta onde seus saves ficam. Não mexa, a não ser que esteja importando saves de um Wii U de verdade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт имя папки, в которой лежат ваши сохранения. Не меняйте, если только не импортируете сохранения с настоящей Wii U."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设定存档所在文件夹的名称。除非你要从真正的 Wii U 导入存档，否则请保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定存檔所在資料夾的名稱。除非你要從真正的 Wii U 匯入存檔，否則請保持不變。"
          }
        }
      }
    },
