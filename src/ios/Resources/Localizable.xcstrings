    "Accounts can't be changed while a game is running." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts lassen sich nicht ändern, solange ein Spiel läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas no se pueden cambiar mientras hay un juego en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes ne peuvent pas être modifiés pendant qu'un jeu est en cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli account non possono essere modificati mentre un gioco è in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームの実行中はアカウントを変更できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
