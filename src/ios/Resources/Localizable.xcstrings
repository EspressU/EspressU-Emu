        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を追加し、アクティブなカスタムサーバーにしました。使うにはネットワークサービスで「カスタム」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 추가하고 활성 커스텀 서버로 지정했습니다. 사용하려면 네트워크 서비스에서 커스텀을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ toegevoegd en de actieve aangepaste server gemaakt. Kies Aangepast onder Netwerkservice om hem te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adicionado e tornado o servidor personalizado ativo. Escolha Personalizado em Serviço de rede para usá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавлено: %@, и сделано активным своим сервером. Выберите «Свой» в разделе «Сетевая служба», чтобы использовать его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已添加 %@ 并将其设为当前使用的自定义服务器。请在网络服务下选择“自定义”来使用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已新增 %@ 並將其設為當前使用的自訂伺服器。請在網路服務下選擇「自訂」來使用它。"
          }
        }
      }
    },
