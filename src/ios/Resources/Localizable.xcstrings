    "Use figure ID 0 to create a blank vehicle or gadget tag for the game to write." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Figuren-ID 0, um ein leeres Fahrzeug- oder Gadget-Tag zu erstellen, das das Spiel beschreiben kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el ID de figura 0 para crear una etiqueta en blanco de vehículo o accesorio en la que escriba el juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez l'ID de figurine 0 pour créer un tag vierge de véhicule ou de gadget dans lequel le jeu écrira."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa l'ID figura 0 per creare un tag vuoto di veicolo o accessorio su cui il gioco possa scrivere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィギュアID 0を使うと、ゲームが書き込める空の乗り物またはガジェットのタグを作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피규어 ID 0을 사용하면 게임이 기록할 수 있는 빈 탈것 또는 가젯 태그를 만들 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik figuur-ID 0 om een lege voertuig- of gadgettag te maken waarop de game kan schrijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o ID de figura 0 para criar uma etiqueta em branco de veículo ou acessório para o jogo gravar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте ID фигурки 0, чтобы создать пустую метку транспорта или гаджета, на которую запишет игра."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用人偶 ID 0 可创建一个空白的载具或配件标签，供游戏写入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用公仔 ID 0 可建立一個空白的載具或配件標籤，供遊戲寫入。"
          }
        }
      }
    },
    "Use games dumped from your own Wii U. A single .wua file is easiest: it holds the game, its update and DLC in one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende Spiele, die du von deiner eigenen Wii U gedumpt hast. Eine einzelne .wua-Datei ist am einfachsten: Sie enthält das Spiel, sein Update und den DLC in einem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa juegos volcados de tu propia Wii U. Un único archivo .wua es lo más fácil: contiene el juego, su actualización y el DLC en uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez des jeux extraits de votre propre Wii U. Un seul fichier .wua est le plus simple : il contient le jeu, sa mise à jour et ses DLC en un seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa giochi estratti dalla tua Wii U. Un singolo file .wua è il più semplice: contiene il gioco, il suo aggiornamento e il DLC in uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご自身の Wii U からダンプしたゲームを使ってください。1つの .wua ファイルが最も簡単です。ゲーム、アップデート、DLC がまとめて入っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인의 Wii U에서 덤프한 게임을 사용하세요. 단일 .wua 파일이 가장 쉽습니다. 게임, 업데이트, DLC가 하나에 들어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik games die je van je eigen Wii U hebt gedumpt. Eén .wua-bestand is het makkelijkst: het bevat de game, de update en de DLC in één."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use jogos extraídos do seu próprio Wii U. Um único arquivo .wua é o mais fácil: ele contém o jogo, a atualização e a DLC em um só."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте игры, снятые с вашей собственной Wii U. Проще всего один файл .wua: в нём игра, её обновление и DLC вместе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用从你自己的 Wii U 转储出的游戏。单个 .wua 文件最简单：它把游戏、更新和 DLC 合在一起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用從你自己的 Wii U 轉儲出的遊戲。單個 .wua 檔案最簡單：它把遊戲、更新和 DLC 合在一起。"
          }
        }
      }
    },
