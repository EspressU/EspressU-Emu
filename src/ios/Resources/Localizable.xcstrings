    "Slower but more accurate: one CPU core and stricter GPU syncing. Can fix a game that glitches or crashes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsamer, aber genauer: ein CPU-Kern und strengere GPU-Synchronisierung. Kann ein Spiel reparieren, das Fehler macht oder abstürzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más lento pero más preciso: un núcleo de CPU y sincronización de GPU más estricta. Puede arreglar un juego que da fallos o se cierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus lent mais plus précis : un cœur CPU et une synchronisation GPU plus stricte. Peut réparer un jeu qui bugue ou plante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più lento ma più preciso: un core CPU e sincronizzazione GPU più rigorosa. Può correggere un gioco che ha glitch o si chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅くなりますが、より正確：CPUコア1つと、より厳密なGPU同期。不具合やクラッシュが起きるゲームが直る場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 느리지만 더 정확합니다: CPU 코어 1개와 더 엄격한 GPU 동기화. 오류가 나거나 충돌하는 게임을 고칠 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trager maar nauwkeuriger: één CPU-kern en strengere GPU-synchronisatie. Kan een game repareren die haperingen vertoont of crasht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais lento, porém mais preciso: um núcleo da CPU e sincronização de GPU mais rígida. Pode consertar um jogo que apresenta falhas ou trava."
          }
        },
        "ru" : {
          "stringUnit" : {
