    "Load a .%@ figure file or create a new one. Figures and their progress are saved in Documents/Emulated Devices. Clear removes the figure from the slot but keeps the file." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade eine .%@-Figurendatei oder erstelle eine neue. Figuren und ihr Fortschritt werden in Documents/Emulated Devices gespeichert. „Leeren“ entfernt die Figur aus dem Slot, behält aber die Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga un archivo de figura .%@ o crea uno nuevo. Las figuras y su progreso se guardan en Documents/Emulated Devices. «Vaciar» quita la figura de la ranura pero conserva el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chargez un fichier de figurine .%@ ou créez-en un nouveau. Les figurines et leur progression sont enregistrées dans Documents/Emulated Devices. « Vider » retire la figurine de l'emplacement mais garde le fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carica un file di figura .%@ o creane uno nuovo. Le figure e i loro progressi sono salvati in Documents/Emulated Devices. «Svuota» toglie la figura dallo slot ma mantiene il file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".%@形式のフィギュアファイルを読み込むか、新規作成します。フィギュアとその進行状況はDocuments/Emulated Devicesに保存されます。「クリア」はスロットからフィギュアを外しますが、ファイルは残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".%@ 피규어 파일을 불러오거나 새로 만드세요. 피규어와 진행 상황은 Documents/Emulated Devices에 저장됩니다. '비우기'는 슬롯에서 피규어를 제거하지만 파일은 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laad een .%@-figuurbestand of maak een nieuw bestand. Figuren en hun voortgang worden opgeslagen in Documents/Emulated Devices. «Wissen» haalt de figuur uit het slot maar houdt het bestand."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carregue um arquivo de figura .%@ ou crie um novo. As figuras e o progresso delas ficam salvos em Documents/Emulated Devices. «Limpar» tira a figura do slot, mas mantém o arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузите файл фигурки .%@ или создайте новый. Фигурки и их прогресс хранятся в Documents/Emulated Devices. «Очистить» убирает фигурку из слота, но оставляет файл."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "载入 .%@ 人偶文件或新建一个。人偶及其进度保存在 Documents/Emulated Devices。“清除”会将人偶从插槽中移除，但保留文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "載入 .%@ 公仔檔案或建立新的。公仔及其進度儲存在 Documents/Emulated Devices。「清除」會將公仔從插槽中移除，但保留檔案。"
          }
        }
      }
    },
    "Load a figure dump you own, create a new one or clear a slot. No figures are included." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
