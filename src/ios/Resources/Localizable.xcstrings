          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ゲームを読み込む」をタップするか、ゲームファイルをファイル > このiPad内 > EspressU > Roms に置いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 가져오기를 탭하거나 게임 파일을 파일 > 나의 iPad > EspressU > Roms에 넣으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Een game importeren, of zet spelbestanden in Bestanden > Op mijn iPad > EspressU > Roms."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Importar um jogo ou coloque os arquivos do jogo em Arquivos > Neste iPad > EspressU > Roms."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Импортировать игру» или положите файлы игры в Файлы > На iPad > EspressU > Roms."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点“导入游戏”，或把游戏文件放进 文件 > 我的 iPad > EspressU > Roms。"
          }
