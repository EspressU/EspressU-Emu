    },
    "This file has %@ settings and %@. Importing replaces all of your settings and every game's own options. Your library, keys and accounts are not touched." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei hat %@ Einstellungen und %@. Das Importieren ersetzt alle deine Einstellungen und die Optionen jedes Spiels. Deine Bibliothek, Schlüssel und Konten bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo tiene %@ ajustes y %@. Al importarlo se reemplazan todos tus ajustes y las opciones propias de cada juego. Tu biblioteca, claves y cuentas no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier contient %@ réglages et %@. L'import remplace tous vos réglages et les options de chaque jeu. Votre bibliothèque, vos clés et vos comptes ne sont pas touchés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file contiene %@ impostazioni e %@. L'importazione sostituisce tutte le tue impostazioni e le opzioni di ogni gioco. Libreria, chiavi e account non vengono toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルには%@個の設定と%@が含まれています。読み込むと、すべての設定と各ゲームのオプションが置き換えられます。ライブラリ、キー、アカウントには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일에는 설정 %@개와 %@이(가) 들어 있습니다. 가져오면 모든 설정과 각 게임의 개별 옵션이 대체됩니다. 라이브러리, 키, 계정은 영향을 받지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bestand bevat %@ instellingen en %@. Importeren vervangt al je instellingen en de eigen opties van elke game. Je bibliotheek, sleutels en accounts blijven ongemoeid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo tem %@ ajustes e %@. Importar substitui todos os seus ajustes e as opções de cada jogo. Sua biblioteca, chaves e contas não são tocadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом файле настроек: %@ и %@. Импорт заменяет все ваши настройки и собственные параметры каждой игры. Библиотека, ключи и учётные записи не затрагиваются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件包含 %@ 项设置和%@。导入会替换你的所有设置以及每款游戏自己的选项。你的游戏库、密钥和账户不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案包含 %@ 項設定和%@。匯入會取代你的所有設定以及每款遊戲自己的選項。你的資料庫、金鑰和帳號不受影響。"
          }
        }
      }
    },
    "This file is encrypted and no matching key is installed. Add your keys.txt in Settings first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
