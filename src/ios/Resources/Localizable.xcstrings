    "Converts textures in the background instead of pausing the game. New textures can show a plain colour for a moment." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wandelt Texturen im Hintergrund um, statt das Spiel anzuhalten. Neue Texturen können kurz einfarbig aussehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte las texturas en segundo plano en lugar de pausar el juego. Las texturas nuevas pueden verse de un color liso por un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertit les textures en arrière-plan au lieu de mettre le jeu en pause. Les nouvelles textures peuvent apparaître unies un court instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converte le texture in background invece di mettere in pausa il gioco. Le nuove texture possono apparire a tinta unita per un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームを一時停止せず、バックグラウンドでテクスチャを変換します。新しいテクスチャは一瞬だけ単色で表示されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임을 멈추는 대신 백그라운드에서 텍스처를 변환합니다. 새 텍스처는 잠깐 단색으로 보일 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet texturen op de achtergrond om in plaats van het spel te pauzeren. Nieuwe texturen kunnen even effen van kleur zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converte as texturas em segundo plano em vez de pausar o jogo. Texturas novas podem aparecer em cor lisa por um instante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преобразует текстуры в фоне, не останавливая игру. Новые текстуры могут ненадолго отображаться однотонными."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
