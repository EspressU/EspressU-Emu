          "stringUnit" : {
            "state" : "translated",
            "value" : " %@ entrées sont inutilisables et ignorées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %@ voci non possono essere usate e vengono saltate."
