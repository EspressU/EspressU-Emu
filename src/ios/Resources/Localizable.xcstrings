        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A esta carpeta de juego le falta un title.tmd o title.tik legible, que EspressU necesita para descifrarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à ce dossier de jeu un title.tmd ou title.tik lisible, dont EspressU a besoin pour le déchiffrer."
