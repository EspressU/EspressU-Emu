    "Graphic Packs" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafikpacks"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Packs gráficos"
          }
        },
        "fr" : {
          "stringUnit" : {
