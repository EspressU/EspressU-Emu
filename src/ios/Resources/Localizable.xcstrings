    "Rendering comes first: steady frames at the game's own Wii U frame rate, never faster." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendern kommt zuerst: gleichmäßige Bilder in der eigenen Wii-U-Bildrate des Spiels, nie schneller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero el renderizado: fotogramas estables a la tasa de fotogramas propia de la Wii U del juego, nunca más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rendu passe d'abord : des images régulières à la fréquence d'images Wii U propre du jeu, jamais plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima il rendering: fotogrammi stabili al frame rate Wii U del gioco, mai più veloci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描画を最優先：ゲーム自身のWii Uフレームレートで安定したフレーム。それより速くなることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "렌더링이 우선입니다: 게임 자체의 Wii U 프레임 속도로 안정적인 프레임을 내며, 그보다 빨라지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderen komt eerst: stabiele frames op de eigen Wii U-framerate van de game, nooit sneller."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderização em primeiro lugar: quadros estáveis na taxa de quadros Wii U do próprio jogo, nunca mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала отрисовка: стабильные кадры с собственной частотой кадров игры на Wii U, никогда быстрее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "渲染优先：以游戏自身的 Wii U 帧率输出稳定的帧，绝不更快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "渲染優先：以遊戲自身的 Wii U 影格率輸出穩定的影格，絕不更快。"
          }
        }
      }
    },
