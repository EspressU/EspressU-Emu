    "This game's own cache file couldn't be opened or created, so nothing was changed. If storage is full, free some up and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eigene Cache-Datei dieses Spiels konnte nicht geöffnet oder erstellt werden, daher wurde nichts geändert. Wenn der Speicher voll ist, schaffe Platz und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir ni crear el archivo de caché propio de este juego, así que no se cambió nada. Si el almacenamiento está lleno, libera algo e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de cache propre à ce jeu n'a pas pu être ouvert ou créé, donc rien n'a été modifié. Si le stockage est plein, libérez de l'espace et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
