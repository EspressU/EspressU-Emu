    "The external display shows the %@ and this device shows the %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das externe Display zeigt %@, und dieses Gerät zeigt %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla externa muestra %@ y este dispositivo muestra %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écran externe affiche %@ et cet appareil affiche %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il display esterno mostra %@ e questo dispositivo mostra %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部ディスプレイには%@を、このデバイスには%@を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외부 디스플레이에는 %@이(가), 이 기기에는 %@이(가) 표시됩니다."
          }
        },
        "nl" : {
