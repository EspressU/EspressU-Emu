    "This game didn't start. Try again. If it keeps happening, close and reopen EspressU." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Spiel ist nicht gestartet. Versuche es erneut. Passiert es weiter, beende EspressU und öffne es neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este juego no se inició. Inténtalo de nuevo. Si sigue pasando, cierra y vuelve a abrir EspressU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu n'a pas démarré. Réessayez. Si cela continue, fermez et rouvrez EspressU."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo gioco non è partito. Riprova. Se continua, chiudi e riapri EspressU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このゲームは起動しませんでした。もう一度お試しください。繰り返し起きる場合は、EspressUを閉じて開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
