    "%@ is now the active Custom server. Pick Custom under Network Service to use it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist jetzt der aktive eigene Server. Wähle unter Netzwerkdienst „Eigen“, um ihn zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es ahora el servidor personalizado activo. Elige Personalizado en Servicio de red para usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est maintenant le serveur personnalisé actif. Choisissez Personnalisé sous Service réseau pour l'utiliser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è ora il server personalizzato attivo. Scegli Personalizzato in Servizio di rete per usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がアクティブなカスタムサーバーになりました。使うにはネットワークサービスで「カスタム」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이제 활성 커스텀 서버입니다. 사용하려면 네트워크 서비스에서 커스텀을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is nu de actieve aangepaste server. Kies Aangepast onder Netwerkservice om hem te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ agora é o servidor personalizado ativo. Escolha Personalizado em Serviço de rede para usá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ теперь активный свой сервер. Выберите «Свой» в разделе «Сетевая служба», чтобы использовать его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 现在是当前使用的自定义服务器。请在网络服务下选择“自定义”来使用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 現在是當前使用的自訂伺服器。請在網路服務下選擇「自訂」來使用它。"
          }
        }
      }
    },
    "%@ is slow to start once while it rebuilds. Clearing the learned shaders as well makes it stutter while it relearns them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ startet einmal langsam, während es neu aufbaut. Wenn du auch die gelernten Shader löschst, ruckelt es, während es sie neu lernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tarda en arrancar una vez mientras se reconstruye. Si borras también los shaders aprendidos, irá a tirones mientras los vuelve a aprender."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ démarre lentement une fois, le temps de se reconstruire. Effacer aussi les shaders appris le fait saccader pendant qu'il les réapprend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è lento ad avviarsi una volta mentre si ricostruisce. Cancellando anche gli shader appresi, scatta mentre li reimpara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は再構築のため初回の起動が一度だけ遅くなります。学習済みシェーダーも消すと、再学習の間カクつきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 다시 빌드하는 동안 처음 한 번 느리게 시작됩니다. 학습된 셰이더도 지우면 다시 학습하는 동안 끊깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ start één keer langzaam terwijl hij zich opnieuw opbouwt. Ook de geleerde shaders wissen laat hem haperen terwijl hij ze opnieuw leert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demora para iniciar uma vez enquanto se recria. Limpar também os shaders aprendidos faz engasgar enquanto os reaprende."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ один раз медленно запустится, пока перестраивается. Если очистить ещё и изученные шейдеры, он будет подтормаживать, пока их заново изучает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在重新构建期间会有一次启动较慢。同时清除已学习的着色器，会让它在重新学习期间卡顿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在重新構建期間會有一次啟動較慢。同時清除已學習的著色器，會讓它在重新學習期間卡頓。"
          }
        }
      }
    },
