    "%@ earlier lines dropped" : {},
    "%@ entries were left out: damaged, not in a usable format, or there wasn't room on this device. If storage is low, free some up and import the file again; entries already added are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Einträge wurden ausgelassen: beschädigt, in keinem nutzbaren Format oder nicht genug Platz auf diesem Gerät. Wenn der Speicher knapp ist, schaffe Platz und importiere die Datei erneut; bereits hinzugefügte Einträge bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entradas se descartaron: dañadas, en un formato inutilizable o sin espacio en este dispositivo. Si queda poco almacenamiento, libera espacio y vuelve a importar el archivo; las entradas ya añadidas se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entrées ont été écartées : endommagées, dans un format inutilisable, ou plus de place sur cet appareil. Si le stockage est faible, libérez de l'espace et réimportez le fichier ; les entrées déjà ajoutées sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ voci sono state escluse: danneggiate, in un formato non utilizzabile o senza spazio sufficiente su questo dispositivo. Se lo spazio è poco, liberane un po' e importa di nuovo il file; le voci già aggiunte vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@件のエントリが除外されました。破損している、使用できない形式である、またはこのデバイスに空き容量がありませんでした。容量が少ない場合は空きを作ってからファイルをもう一度読み込んでください。追加済みのエントリは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목 %@개가 제외되었습니다. 손상되었거나, 사용할 수 없는 형식이거나, 이 기기에 공간이 부족했습니다. 저장 공간이 부족하면 공간을 확보한 후 파일을 다시 가져오세요. 이미 추가된 항목은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ items zijn weggelaten: beschadigd, in een onbruikbaar formaat of geen ruimte op dit apparaat. Als de opslag bijna vol is, maak dan ruimte vrij en importeer het bestand opnieuw; al toegevoegde items blijven behouden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entradas ficaram de fora: danificadas, em formato inutilizável ou sem espaço neste dispositivo. Se o armazenamento estiver baixo, libere espaço e importe o arquivo de novo; as entradas já adicionadas são mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записей пропущено: %@ — повреждены, в неподходящем формате или не хватило места на этом устройстве. Если памяти мало, освободите место и импортируйте файл снова; уже добавленные записи остаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %@ 个条目被排除：已损坏、格式无法使用，或此设备空间不足。如果存储空间不足，请先释放空间，然后重新导入该文件；已添加的条目会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %@ 個條目被排除：已損壞、格式無法使用，或此裝置空間不足。如果儲存空間不足，請先釋放空間，然後重新匯入該檔案；已新增的條目會保留。"
          }
        }
      }
    },
