    "Frees space. Each game is slow to start once." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt Speicher frei. Jedes Spiel startet einmal langsam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera espacio. Cada juego tardará en arrancar la primera vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libère de l'espace. Chaque jeu démarre lentement une fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera spazio. Ogni gioco sarà lento ad avviarsi la prima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量を空けます。各ゲームは初回の起動が遅くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간을 확보합니다. 각 게임은 처음 한 번 느리게 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt ruimte vrij. Elke game start de eerste keer langzaam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera espaço. Cada jogo demora para iniciar na primeira vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освобождает место. Каждая игра при первом запуске будет стартовать медленно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "释放空间。每款游戏首次启动会较慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "釋出空間。每款遊戲首次啟動會較慢。"
          }
        }
      }
    },
    "Frees up the space it uses. Saves and settings are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt den belegten Platz frei. Spielstände und Einstellungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera el espacio que usa. Se conservan las partidas guardadas y los ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libère l'espace utilisé. Les sauvegardes et réglages sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera lo spazio che usa. Salvataggi e impostazioni vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用中の容量を空けます。セーブデータと設定は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
