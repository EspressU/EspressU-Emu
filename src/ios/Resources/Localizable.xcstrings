        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본으로 전환할 때 저장되었습니다. '기본값 유지'를 누르면 잊혀집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
