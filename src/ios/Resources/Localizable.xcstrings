          }
        }
      }
    },
    "Like Reset all settings, and every game's own options go back too. The welcome guide opens again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie „Alle Einstellungen zurücksetzen“, und auch die Optionen jedes Spiels werden zurückgesetzt. Die Willkommensanleitung öffnet sich erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como Restablecer todos los ajustes, y además se restablecen las opciones propias de cada juego. La guía de bienvenida vuelve a abrirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme « Réinitialiser tous les réglages », et les options propres à chaque jeu sont aussi réinitialisées. Le guide de bienvenue s'ouvre de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come Ripristina tutte le impostazioni, e tornano indietro anche le opzioni di ogni gioco. La guida di benvenuto si riapre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「すべての設定をリセット」と同じで、各ゲーム個別のオプションも元に戻ります。ウェルカムガイドが再び開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 설정 재설정과 같으며, 각 게임의 개별 옵션도 초기화됩니다. 환영 가이드가 다시 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoals Alle instellingen herstellen, en de eigen opties van elke game gaan ook terug. De welkomstgids opent opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como Redefinir todos os ajustes, e as opções de cada jogo também voltam ao padrão. O guia de boas-vindas abre de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как «Сбросить все настройки», и собственные параметры каждой игры тоже сбрасываются. Приветственное руководство откроется снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与“重置所有设置”相同，每款游戏自己的选项也会恢复。欢迎指南会再次打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與「重置所有設定」相同，每款遊戲自己的選項也會恢復。歡迎指南會再次開啟。"
          }
        }
      }
    },
