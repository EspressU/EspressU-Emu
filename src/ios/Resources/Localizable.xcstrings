    "%@/account.dat isn't a readable Wii U account file, or its folder name isn't an 8-digit account ID like 80000001." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat ist keine lesbare Wii-U-Kontodatei, oder ihr Ordnername ist keine achtstellige Konto-ID wie 80000001."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat no es un archivo de cuenta de Wii U legible, o el nombre de su carpeta no es un ID de cuenta de 8 dígitos como 80000001."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat n'est pas un fichier de compte Wii U lisible, ou le nom de son dossier n'est pas un ID de compte à 8 chiffres comme 80000001."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat non è un file account Wii U leggibile, oppure il nome della sua cartella non è un ID account di 8 cifre come 80000001."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat は読み取れる Wii U アカウントファイルではないか、フォルダ名が 80000001 のような8桁のアカウントIDではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat는 읽을 수 있는 Wii U 계정 파일이 아니거나 폴더 이름이 80000001 같은 8자리 계정 ID가 아닙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat is geen leesbaar Wii U-accountbestand, of de mapnaam is geen account-ID van 8 cijfers zoals 80000001."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat não é um arquivo de conta de Wii U legível, ou o nome da pasta dele não é um ID de conta de 8 dígitos como 80000001."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat не является читаемым файлом учётной записи Wii U, или имя его папки не является 8-значным ID учётной записи, например 80000001."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat 不是可读取的 Wii U 账户文件，或者其文件夹名不是像 80000001 这样的 8 位账户 ID。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/account.dat 不是可讀取的 Wii U 賬戶檔案，或者其資料夾名不是像 80000001 這樣的 8 位賬戶 ID。"
          }
        }
      }
    },
