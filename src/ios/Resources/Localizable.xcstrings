    "2.2 is standard. Lower is brighter in the mid-tones." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,2 ist Standard. Niedriger macht die Mitteltöne heller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,2 es lo estándar. Más bajo aclara los tonos medios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,2 est la valeur standard. Plus bas éclaircit les tons moyens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,2 è lo standard. Più basso è più luminoso nei mezzi toni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2.2が標準です。低くすると中間調が明るくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2.2가 표준입니다. 낮출수록 중간 톤이 밝아집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,2 is standaard. Lager is helderder in de middentonen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,2 é o padrão. Mais baixo deixa os meios-tons mais claros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,2 — стандарт. Меньше значение — ярче средние тона."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2.2 为标准值。数值越低，中间调越亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2.2 為標準值。數值越低，中間調越亮。"
          }
        }
      }
    },
