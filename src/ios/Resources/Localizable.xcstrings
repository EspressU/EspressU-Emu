    "Checks for new community packs every time EspressU opens and installs them in the background." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft bei jedem Start von EspressU auf neue Community-Packs und installiert sie im Hintergrund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca nuevos packs de la comunidad cada vez que se abre EspressU y los instala en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche de nouveaux packs communautaires à chaque ouverture d'EspressU et les installe en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca nuovi pack della community a ogni apertura di EspressU e li installa in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressUを開くたびに新しいコミュニティパックを確認し、バックグラウンドでインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EspressU를 열 때마다 새 커뮤니티 팩을 확인하고 백그라운드에서 설치합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleert elke keer dat EspressU opent op nieuwe communitypacks en installeert ze op de achtergrond."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procura novos packs da comunidade sempre que o EspressU é aberto e os instala em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет новые пакеты сообщества при каждом запуске EspressU и устанавливает их в фоновом режиме."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次打开 EspressU 时检查新的社区包,并在后台安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次開啟 EspressU 時檢查新的社群包,並在背景安裝。"
          }
        }
      }
    },
    "Converts textures in the background instead of pausing the game. New textures can show a plain colour for a moment." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wandelt Texturen im Hintergrund um, statt das Spiel anzuhalten. Neue Texturen können kurz einfarbig aussehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte las texturas en segundo plano en lugar de pausar el juego. Las texturas nuevas pueden verse de un color liso por un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertit les textures en arrière-plan au lieu de mettre le jeu en pause. Les nouvelles textures peuvent apparaître unies un court instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converte le texture in background invece di mettere in pausa il gioco. Le nuove texture possono apparire a tinta unita per un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームを一時停止せず、バックグラウンドでテクスチャを変換します。新しいテクスチャは一瞬だけ単色で表示されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임을 멈추는 대신 백그라운드에서 텍스처를 변환합니다. 새 텍스처는 잠깐 단색으로 보일 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet texturen op de achtergrond om in plaats van het spel te pauzeren. Nieuwe texturen kunnen even effen van kleur zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converte as texturas em segundo plano em vez de pausar o jogo. Texturas novas podem aparecer em cor lisa por um instante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преобразует текстуры в фоне, не останавливая игру. Новые текстуры могут ненадолго отображаться однотонными."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台转换纹理,而不是暂停游戏。新纹理可能会短暂显示为纯色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在背景轉換紋理,而不是暫停遊戲。新紋理可能會短暫顯示為純色。"
          }
        }
      }
    },
