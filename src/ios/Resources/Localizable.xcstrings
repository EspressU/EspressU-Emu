    "Pair it in Settings › Bluetooth. Xbox, PlayStation, Switch Pro and MFi controllers work, in games and in every menu of EspressU." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppeln unter Einstellungen › Bluetooth. Xbox-, PlayStation-, Switch-Pro- und MFi-Controller funktionieren, in Spielen und in jedem Menü von EspressU."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empárejalo en Ajustes › Bluetooth. Funcionan mandos de Xbox, PlayStation, Switch Pro y MFi, en los juegos y en todos los menús de EspressU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associez-la dans Réglages › Bluetooth. Les manettes Xbox, PlayStation, Switch Pro et MFi fonctionnent, dans les jeux et dans chaque menu d'EspressU."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbinalo in Impostazioni › Bluetooth. Funzionano i controller Xbox, PlayStation, Switch Pro e MFi, nei giochi e in ogni menu di EspressU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 › Bluetooth でペアリングしてください。Xbox、PlayStation、Switch Pro、MFi コントローラーが、ゲーム内でも EspressU のすべてのメニューでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › Bluetooth에서 페어링하세요. Xbox, PlayStation, Switch Pro, MFi 컨트롤러가 게임에서도, EspressU의 모든 메뉴에서도 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel hem in Instellingen › Bluetooth. Xbox-, PlayStation-, Switch Pro- en MFi-controllers werken, in games en in elk menu van EspressU."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pareie em Ajustes › Bluetooth. Controles de Xbox, PlayStation, Switch Pro e MFi funcionam, nos jogos e em todos os menus do EspressU."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свяжите его в Настройки › Bluetooth. Работают контроллеры Xbox, PlayStation, Switch Pro и MFi — в играх и в каждом меню EspressU."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 设置 › 蓝牙 中配对。Xbox、PlayStation、Switch Pro 和 MFi 手柄均可使用，既可在游戏中，也可在 EspressU 的每个菜单中使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在 設定 › 藍芽 中配對。Xbox、PlayStation、Switch Pro 和 MFi 手柄均可使用，既可在遊戲中，也可在 EspressU 的每個選單中使用。"
          }
        }
      }
    },
