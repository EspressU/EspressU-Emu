    "Rebuilds the default button bindings. Use it if some buttons do nothing while the sticks still work." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt die Standard-Tastenbelegung wieder her. Nutze es, wenn manche Tasten nichts tun, die Sticks aber funktionieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruye las asignaciones de botones predeterminadas. Úsalo si algunos botones no hacen nada mientras las palancas siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruit les assignations de boutons par défaut. Utile si certains boutons ne font rien alors que les sticks fonctionnent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruisce le assegnazioni predefinite dei pulsanti. Usalo se alcuni pulsanti non fanno nulla mentre le levette funzionano ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボタンの初期割り当てを作り直します。スティックは動くのに一部のボタンが反応しないときに使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 버튼 할당을 다시 만듭니다. 스틱은 작동하는데 일부 버튼이 아무 반응이 없을 때 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouwt de standaard knoptoewijzingen opnieuw op. Gebruik dit als sommige knoppen niets doen terwijl de sticks nog werken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recria as atribuições padrão dos botões. Use se alguns botões não fazem nada enquanto os direcionais ainda funcionam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пересоздаёт назначения кнопок по умолчанию. Используйте, если некоторые кнопки ничего не делают, а стики работают."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重建默认按键绑定。如果摇杆仍可用但有些按键没有反应，请使用此项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重建預設按鍵綁定。如果搖桿仍可用但有些按鍵沒有反應，請使用此項。"
          }
        }
      }
    },
