          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het eigen cachebestand van deze game kon niet worden geopend of gemaakt, dus er is niets gewijzigd. Als de opslag vol is, maak dan wat vrij en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo de cache próprio deste jogo não pôde ser aberto nem criado, então nada foi alterado. Se o armazenamento estiver cheio, libere espaço e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
