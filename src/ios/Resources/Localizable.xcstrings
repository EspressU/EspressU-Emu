    "Added %@ and made it the active Custom server. Pick Custom under Network Service to use it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hinzugefügt und zum aktiven eigenen Server gemacht. Wähle unter Netzwerkdienst „Eigen“, um ihn zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ añadido y establecido como servidor personalizado activo. Elige Personalizado en Servicio de red para usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
