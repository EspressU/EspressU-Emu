    "An account with the same ID is already installed. If you replace it, its account.dat is saved next to the new one first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Konto mit derselben ID ist bereits installiert. Wenn du es ersetzt, wird seine account.dat vorher neben der neuen gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay instalada una cuenta con el mismo ID. Si la reemplazas, su account.dat se guarda antes junto a la nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte avec le même identifiant est déjà installé. Si vous le remplacez, son account.dat est d'abord enregistré à côté du nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un account con lo stesso ID è già installato. Se lo sostituisci, il suo account.dat viene prima salvato accanto al nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ ID のアカウントがすでにインストールされています。置き換えると、新しいアカウントの隣に既存の account.dat が先に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 ID의 계정이 이미 설치되어 있습니다. 바꾸면 새 계정 옆에 기존 account.dat가 먼저 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is al een account met hetzelfde ID geïnstalleerd. Als je het vervangt, wordt de account.dat ervan eerst naast de nieuwe opgeslagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já há uma conta com o mesmo ID instalada. Se você a substituir, o account.dat dela é salvo ao lado do novo antes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учётная запись с таким же ID уже установлена. Если заменить её, её account.dat сначала сохраняется рядом с новым."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装了相同 ID 的账户。如果替换它，会先把它的 account.dat 保存在新账户旁边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安裝了相同 ID 的賬戶。如果替換它，會先把它的 account.dat 儲存在新賬戶旁邊。"
          }
        }
      }
    },
