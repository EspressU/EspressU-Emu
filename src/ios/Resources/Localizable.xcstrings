    "Type the addresses the server's host gave you." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die Adressen ein, die dir der Host des Servers gegeben hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe las direcciones que te dio el anfitrión del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez les adresses que l'hôte du serveur vous a données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita gli indirizzi che ti ha dato il gestore del server."
