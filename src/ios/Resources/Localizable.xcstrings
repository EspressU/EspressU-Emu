    "Built-in pairing needs iOS %@ or newer. Import a pairing file instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das integrierte Pairing braucht iOS %@ oder neuer. Importiere stattdessen eine Pairing-Datei."
          }
        },
        "es" : {
