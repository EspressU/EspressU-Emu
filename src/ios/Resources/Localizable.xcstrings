          }
        }
      }
    },
    "This deletes \"%@\" from EspressU to free up space. Your saves and options are kept. To play it again, add the game back." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das löscht „%@“ aus EspressU, um Platz freizugeben. Deine Spielstände und Optionen bleiben erhalten. Um es wieder zu spielen, füge das Spiel erneut hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina «%@» de EspressU para liberar espacio. Se conservan tus partidas guardadas y opciones. Para volver a jugarlo, vuelve a añadir el juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime « %@ » d'EspressU pour libérer de l'espace. Vos sauvegardes et options sont conservées. Pour y rejouer, ajoutez à nouveau le jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elimina «%@» da EspressU per liberare spazio. Salvataggi e opzioni vengono mantenuti. Per giocarlo di nuovo, aggiungi di nuovo il gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量を空けるため、「%@」をEspressUから削除します。セーブデータとオプションは残ります。もう一度遊ぶには、ゲームを追加し直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간을 확보하기 위해 EspressU에서 \"%@\"을(를) 삭제합니다. 저장 데이터와 옵션은 유지됩니다. 다시 플레이하려면 게임을 다시 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert «%@» uit EspressU om ruimte vrij te maken. Je opgeslagen games en opties blijven bewaard. Om hem weer te spelen, voeg je de game opnieuw toe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto apaga «%@» do EspressU para liberar espaço. Seus saves e opções são mantidos. Para jogar de novo, adicione o jogo outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит «%@» из EspressU, чтобы освободить место. Ваши сохранения и параметры остаются. Чтобы снова играть, добавьте игру заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从 EspressU 中删除“%@”以释放空间。你的存档和选项会保留。若要再次游玩，请重新添加该游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從 EspressU 中刪除「%@」以釋出空間。你的存檔和選項會保留。若要再次遊玩，請重新加入該遊戲。"
          }
        }
      }
    },
