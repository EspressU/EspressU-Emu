    "Metal draws the picture. Resolution, filters and gamma apply from the next game you start." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal zeichnet das Bild. Auflösung, Filter und Gamma gelten ab dem nächsten Spiel, das du startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal dibuja la imagen. La resolución, los filtros y el gamma se aplican desde el próximo juego que inicies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal dessine l'image. La résolution, les filtres et le gamma s'appliquent à partir du prochain jeu que vous lancez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal disegna l'immagine. Risoluzione, filtri e gamma si applicano dal prossimo gioco che avvii."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal が映像を描画します。解像度、フィルター、ガンマは次に起動するゲームから適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal이 화면을 그립니다. 해상도, 필터, 감마는 다음에 시작하는 게임부터 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal tekent het beeld. Resolutie, filters en gamma gelden vanaf de volgende game die je start."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Metal desenha a imagem. Resolução, filtros e gama valem a partir do próximo jogo que você iniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal рисует изображение. Разрешение, фильтры и гамма применяются со следующей игры, которую вы запустите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal 负责绘制画面。分辨率、滤镜和伽马将从你下次启动的游戏起生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal 負責繪製畫面。解析度、濾鏡和伽馬將從你下次啟動的遊戲起生效。"
          }
        }
      }
    },
