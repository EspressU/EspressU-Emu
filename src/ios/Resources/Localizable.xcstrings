    "This device has no motion sensors, so the GamePad will stay still." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat keine Bewegungssensoren, daher bleibt das GamePad still."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no tiene sensores de movimiento, así que el GamePad permanecerá quieto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n'a pas de capteurs de mouvement, le GamePad restera donc immobile."
          }
        },
        "it" : {
          "stringUnit" : {
