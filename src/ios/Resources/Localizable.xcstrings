    " %@ entries can't be used and are skipped." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %@ Einträge sind nicht nutzbar und werden übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %@ entradas no se pueden usar y se omiten."
          }
        },
