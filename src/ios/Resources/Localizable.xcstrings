    "Saves every setting and every game's own options to one file you can keep or move to another device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert jede Einstellung und die Optionen jedes einzelnen Spiels in einer Datei, die du aufbewahren oder auf ein anderes Gerät mitnehmen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda todos los ajustes y las opciones propias de cada juego en un solo archivo que puedes conservar o llevar a otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre tous les réglages et les options propres à chaque jeu dans un seul fichier que vous pouvez garder ou transférer vers un autre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva ogni impostazione e le opzioni di ogni singolo gioco in un solo file che puoi conservare o spostare su un altro dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての設定とゲームごとのオプションを、保管や別のデバイスへの移行ができる1つのファイルに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 설정과 각 게임의 개별 옵션을 보관하거나 다른 기기로 옮길 수 있는 하나의 파일로 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart elke instelling en de opties van elke game in één bestand dat je kunt bewaren of naar een ander apparaat kunt meenemen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva todos os ajustes e as opções de cada jogo em um único arquivo que você pode guardar ou levar para outro dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет все настройки и параметры каждой игры в один файл, который можно хранить или перенести на другое устройство."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
