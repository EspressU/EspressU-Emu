        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — кэш изученных шейдеров, а не кэш конвейеров. Для него используйте «Импорт изученных шейдеров»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
