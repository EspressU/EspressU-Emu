    "Slightly softer than Native, noticeably cheaper to draw." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas weicher als Nativ, spürbar günstiger zu zeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco más suave que Nativa, claramente más barata de dibujar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un peu plus doux que Natif, nettement moins coûteux à dessiner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
