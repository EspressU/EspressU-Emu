          }
        }
      }
    },
    "Built-in pairing needs iOS %@ or newer. Make a pairing file with iLoader or idevice_pair, then tap Import." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das integrierte Pairing braucht iOS %@ oder neuer. Erstelle eine Pairing-Datei mit iLoader oder idevice_pair und tippe dann auf „Importieren“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El emparejamiento integrado requiere iOS %@ o posterior. Crea un archivo de emparejamiento con iLoader o idevice_pair y pulsa Importar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appairage intégré nécessite iOS %@ ou plus récent. Créez un fichier d'appairage avec iLoader ou idevice_pair, puis touchez Importer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abbinamento integrato richiede iOS %@ o successivo. Crea un file di abbinamento con iLoader o idevice_pair, poi tocca Importa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内蔵ペアリングには iOS %@ 以降が必要です。iLoader または idevice_pair でペアリングファイルを作成し、「読み込む」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 제공 페어링에는 iOS %@ 이상이 필요합니다. iLoader 또는 idevice_pair로 페어링 파일을 만든 다음 가져오기를 탭하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingebouwd koppelen vereist iOS %@ of nieuwer. Maak een koppelbestand met iLoader of idevice_pair en tik dan op Importeren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pareamento integrado requer iOS %@ ou mais recente. Crie um arquivo de pareamento com o iLoader ou o idevice_pair e toque em Importar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенному сопряжению нужна iOS %@ или новее. Создайте файл сопряжения с помощью iLoader или idevice_pair, затем нажмите «Импорт»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置配对需要 iOS %@ 或更高版本。请用 iLoader 或 idevice_pair 制作配对文件，然后轻点“导入”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內建配對需要 iOS %@ 或更高版本。請用 iLoader 或 idevice_pair 製作配對檔案，然後輕點「匯入」。"
          }
        }
      }
    },
