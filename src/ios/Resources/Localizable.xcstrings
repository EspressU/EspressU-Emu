            "state" : "translated",
            "value" : "Het externe scherm toont %@ en dit apparaat toont %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela externa mostra %@ e este dispositivo mostra %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
