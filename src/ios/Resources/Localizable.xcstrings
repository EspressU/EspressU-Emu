            "state" : "translated",
            "value" : "La vinculación integrada necesita iOS %@ o posterior. Importa un archivo de vinculación en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appairage intégré nécessite iOS %@ ou plus récent. Importez plutôt un fichier d'appairage."
          }
        },
        "it" : {
