    "\"%@\" already exists in your library. Replacing it can't be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist bereits in deiner Bibliothek. Das Ersetzen lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ya existe en tu biblioteca. Reemplazarlo no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » existe déjà dans votre bibliothèque. Le remplacer est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» esiste già nella tua libreria. La sostituzione non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はすでにライブラリにあります。置き換えると元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"은(는) 이미 라이브러리에 있습니다. 바꾸면 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» bestaat al in je bibliotheek. Vervangen kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» já existe na sua biblioteca. A substituição não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» уже есть в вашей библиотеке. Замену нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已存在于你的游戏库中。替换后无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已存在於你的資料庫中。替換後無法撤銷。"
          }
        }
      }
    },
    "\"%@\" is a cache for %@, but none of its %@ entries can be used." : {
