    "What this game has saved so it starts faster. Clearing needs the game closed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was dieses Spiel gespeichert hat, damit es schneller startet. Zum Leeren muss das Spiel beendet sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que ha guardado este juego para arrancar más rápido. Para vaciar, el juego debe estar cerrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que ce jeu a enregistré pour démarrer plus vite. Le jeu doit être fermé pour vider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che questo gioco ha salvato per partire più velocemente. Per svuotare il gioco deve essere chiuso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このゲームが、より速く起動するために保存したもの。消去にはゲームを終了している必要があります。"
