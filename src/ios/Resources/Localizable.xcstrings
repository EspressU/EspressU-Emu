    },
    "The fast way to run games. Needs a JIT enabler; without one the slow interpreter runs instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der schnelle Weg, Spiele zu starten. Braucht einen JIT-Aktivierer; ohne läuft stattdessen der langsame Interpreter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La forma rápida de ejecutar juegos. Necesita un activador de JIT; sin él se ejecuta el intérprete lento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La manière rapide de lancer les jeux. Nécessite un activateur JIT ; sans lui, c'est le lent interpréteur qui tourne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modo veloce di eseguire i giochi. Serve un attivatore JIT; senza, viene usato il lento interprete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームを高速に動かす方法です。JITイネーブラが必要で、ない場合は低速のインタープリタで動きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임을 빠르게 실행하는 방법입니다. JIT 활성화 도구가 필요하며, 없으면 느린 인터프리터가 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De snelle manier om games te draaien. Heeft een JIT-activator nodig; zonder draait de trage interpreter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jeito rápido de rodar jogos. Precisa de um ativador de JIT; sem um, roda o interpretador lento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрый способ запуска игр. Нужен активатор JIT; без него работает медленный интерпретатор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行游戏的快速方式。需要 JIT 启用器；没有的话会改用较慢的解释器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行遊戲的快速方式。需要 JIT 啟用器；沒有的話會改用較慢的直譯器。"
          }
        }
      }
    },
