    "The game stopped. Go back and try it again. If it keeps happening, close and reopen EspressU." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel wurde gestoppt. Gehe zurück und versuche es erneut. Passiert es weiter, beende EspressU und öffne es neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego se detuvo. Vuelve atrás e inténtalo de nuevo. Si sigue pasando, cierra y vuelve a abrir EspressU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu s'est arrêté. Revenez en arrière et réessayez. Si cela continue, fermez et rouvrez EspressU."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gioco si è interrotto. Torna indietro e riprova. Se continua, chiudi e riapri EspressU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームが停止しました。戻ってもう一度お試しください。繰り返し起きる場合は、EspressUを閉じて開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임이 멈췄습니다. 돌아가서 다시 시도하세요. 계속되면 EspressU를 닫았다가 다시 여세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De game is gestopt. Ga terug en probeer het opnieuw. Als het blijft gebeuren, sluit EspressU en open het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo parou. Volte e tente de novo. Se continuar acontecendo, feche e abra o EspressU de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра остановилась. Вернитесь и попробуйте снова. Если это повторяется, закройте и снова откройте EspressU."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏已停止。请返回后重试。如果持续发生，请关闭并重新打开 EspressU。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
