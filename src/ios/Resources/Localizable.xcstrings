    "Only needed for encrypted games. Homebrew and already-decrypted dumps don't need keys." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für verschlüsselte Spiele nötig. Homebrew und bereits entschlüsselte Dumps brauchen keine Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo hace falta para juegos cifrados. Los homebrew y los volcados ya descifrados no necesitan claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire uniquement pour les jeux chiffrés. Les homebrews et les dumps déjà déchiffrés n'ont pas besoin de clés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
