    "The same version is already installed. Reinstalling replaces it. Save data is not touched." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieselbe Version ist bereits installiert. Neuinstallation ersetzt sie. Spielstände bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma versión ya está instalada. Reinstalar la reemplaza. Las partidas guardadas no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La même version est déjà installée. La réinstaller la remplace. Les données de sauvegarde ne sont pas touchées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stessa versione è già installata. La reinstallazione la sostituisce. I dati di salvataggio non vengono toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じバージョンがすでにインストールされています。再インストールすると置き換えられます。セーブデータには手を加えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 버전이 이미 설치되어 있습니다. 다시 설치하면 대체됩니다. 저장 데이터는 건드리지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezelfde versie is al geïnstalleerd. Opnieuw installeren vervangt hem. Opgeslagen games worden niet aangeraakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mesma versão já está instalada. Reinstalar a substitui. Os saves não são tocados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Такая же версия уже установлена. Переустановка заменяет её. Данные сохранений не затрагиваются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
