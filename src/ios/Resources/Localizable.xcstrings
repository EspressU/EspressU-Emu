          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só é necessário se você vincular depois esta conta a um NNID/PNID para jogar online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, только если позже вы привяжете эту учётную запись к NNID/PNID для игры по сети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
