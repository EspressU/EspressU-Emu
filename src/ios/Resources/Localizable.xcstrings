    "Auto picked one core: a three-core run of this title crashed or hung before" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch ein Kern: Ein Drei-Kern-Lauf dieses Titels ist zuvor abgestürzt oder hängen geblieben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: un núcleo, porque una ejecución con tres núcleos de este título falló o se colgó antes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto : un cœur, car une exécution à trois cœurs de ce titre a déjà planté ou bloqué"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: un core, perché un'esecuzione a tre core di questo titolo è andata in crash o si è bloccata prima"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動で1コア: このタイトルを3コアで動かした際に、以前クラッシュまたはフリーズしました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 코어 1개: 이 타이틀을 코어 3개로 실행했을 때 이전에 충돌하거나 멈췄습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch één kern: een run met drie kernen van deze titel is eerder gecrasht of vastgelopen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: um núcleo, porque uma execução com três núcleos deste título travou ou falhou antes"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авто: одно ядро, потому что запуск этой игры на трёх ядрах раньше завершался сбоем или зависал"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动选择单核：此游戏之前使用三核运行时崩溃或卡死"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動選擇單核：此遊戲之前使用三核執行時崩潰或卡死"
          }
        }
      }
    },
