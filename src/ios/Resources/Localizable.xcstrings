        }
      }
    },
    "Only needed if you later link this account to an NNID/PNID for online play." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur nötig, wenn du dieses Konto später für Online-Spiel mit einer NNID/PNID verknüpfst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo hace falta si más adelante vinculas esta cuenta a un NNID/PNID para jugar en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire seulement si vous liez plus tard ce compte à un NNID/PNID pour le jeu en ligne."
          }
        },
        "it" : {
          "stringUnit" : {
