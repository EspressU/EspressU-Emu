          }
        }
      }
    },
    "Softest, coolest, longest-running. Use it when a game won't hold its frame rate." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am weichsten, am kühlsten, am längsten durchhaltend. Nutze es, wenn ein Spiel die Bildrate nicht hält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La más suave, fresca y duradera. Úsala cuando un juego no mantiene su tasa de fotogramas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus doux, le plus frais, le plus endurant. À utiliser quand un jeu ne tient pas sa fréquence d'images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La più morbida, fresca e duratura. Usala quando un gioco non mantiene il suo frame rate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最もやわらかく、最も低発熱で、最も長持ち。ゲームがフレームレートを保てないときに使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 부드럽고, 가장 시원하며, 가장 오래갑니다. 게임이 프레임 속도를 유지하지 못할 때 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachtst, koelst, langst. Gebruik dit als een game zijn framerate niet haalt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mais suave, fria e duradoura. Use quando um jogo não segura a taxa de quadros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самая мягкая, прохладная и долгая. Используйте, когда игра не держит частоту кадров."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最柔和、最凉爽、最持久。当游戏无法保持帧率时使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最柔和、最涼爽、最持久。當遊戲無法維持影格率時使用。"
          }
        }
      }
    },
    "Some files couldn't be copied, so the decrypted copy is incomplete. Your original wasn't changed. Free up some space and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Dateien konnten nicht kopiert werden, daher ist die entschlüsselte Kopie unvollständig. Dein Original wurde nicht verändert. Schaffe Platz und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron copiar algunos archivos, así que la copia descifrada está incompleta. Tu original no se modificó. Libera algo de espacio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains fichiers n'ont pas pu être copiés, la copie déchiffrée est donc incomplète. Votre original n'a pas été modifié. Libérez de l'espace et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni file non sono stati copiati, quindi la copia decifrata è incompleta. L'originale non è stato modificato. Libera spazio e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のファイルをコピーできなかったため、復号したコピーは不完全です。元のファイルは変更されていません。容量を空けてもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 파일을 복사할 수 없어 복호화된 사본이 불완전합니다. 원본은 변경되지 않았습니다. 공간을 확보한 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige bestanden konden niet worden gekopieerd, dus de ontsleutelde kopie is onvolledig. Je origineel is niet gewijzigd. Maak ruimte vrij en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns arquivos não puderam ser copiados, então a cópia descriptografada está incompleta. Seu original não foi alterado. Libere espaço e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые файлы не удалось скопировать, поэтому расшифрованная копия неполная. Ваш оригинал не изменён. Освободите место и повторите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些文件无法复制，因此解密后的副本不完整。你的原件未被更改。请释放一些空间后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些檔案無法複製，因此解密後的副本不完整。你的原始檔案未被更改。請釋出一些空間後重試。"
          }
        }
      }
    },
    "Some files couldn't be read, so no .wua was made." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
