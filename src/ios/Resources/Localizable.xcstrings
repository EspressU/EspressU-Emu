          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pack grafici"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラフィックパック"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그래픽 팩"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafische packs"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacotes gráficos"
          }
        },
        "ru" : {
          "stringUnit" : {
