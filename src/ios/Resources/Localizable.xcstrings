    "Remove the %@ installed for \"%@\"? This can't be undone - you'll need to import it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das für „%@“ installierte %@ entfernen? Das lässt sich nicht rückgängig machen – du musst es erneut importieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar %@ instalado para «%@»? No se puede deshacer: tendrás que importarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer le %@ installé pour « %@ » ? C'est irréversible – vous devrez l'importer à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere %@ installato per «%@»? Non si può annullare: dovrai importarlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%2$@」用にインストールされた%1$@を削除しますか？この操作は取り消せません。もう一度読み込む必要があります。"
