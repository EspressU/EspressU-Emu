    "There are no shader files for this game yet. Play it first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Spiel gibt es noch keine Shader-Dateien. Spiele es zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay archivos de shaders para este juego. Juégalo primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas encore de fichiers de shaders pour ce jeu. Jouez-y d'abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sono ancora file shader per questo gioco. Giocaci prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このゲームのシェーダーファイルはまだありません。先にプレイしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 게임의 셰이더 파일이 아직 없습니다. 먼저 플레이해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn nog geen shaderbestanden voor deze game. Speel hem eerst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há arquivos de shader para este jogo. Jogue primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этой игры ещё нет файлов шейдеров. Сначала поиграйте в неё."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此游戏还没有着色器文件。请先玩一会儿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此遊戲還沒有著色器檔案。請先玩一會兒。"
          }
        }
      }
    },
    "There is no game data for this install yet. Scrape it from Settings > Cover + data scraping, or here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Installation gibt es noch keine Spieldaten. Rufe sie unter Einstellungen > Cover- und Datenabruf ab, oder hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay datos de juego para esta instalación. Obtenlos desde Ajustes > Carátulas y datos, o aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas encore de données de jeu pour cette installation. Récupérez-les depuis Réglages > Récupération des pochettes et données, ou ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sono ancora dati di gioco per questa installazione. Ottienili da Impostazioni > Copertine e dati, o da qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このインストールにはまだゲームデータがありません。設定 > カバーとデータの取得、またはここから取得してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설치본에는 아직 게임 데이터가 없습니다. 설정 > 커버 및 데이터 가져오기 또는 여기에서 가져오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn nog geen gamegegevens voor deze installatie. Haal ze op via Instellingen > Covers en gegevens ophalen, of hier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há dados de jogo para esta instalação. Busque-os em Ajustes > Capas e dados, ou aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этой установки пока нет данных об играх. Загрузите их в «Настройки» > «Обложки и данные» или здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此安装尚无游戏数据。请从“设置”>“封面与数据抓取”或在此处抓取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此安裝尚無遊戲資料。請從「設定」>「封面與資料擷取」或在此處擷取。"
          }
        }
      }
    },
    "There's no save for this game yet. Play it once, then export." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Spiel gibt es noch keinen Spielstand. Spiele es einmal und exportiere dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este juego aún no tiene partida guardada. Juega una vez y luego exporta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas encore de sauvegarde pour ce jeu. Jouez-y une fois, puis exportez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo gioco non ha ancora un salvataggio. Giocalo una volta, poi esporta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このゲームにはまだセーブデータがありません。一度プレイしてから書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 게임에는 아직 저장 데이터가 없습니다. 한 번 플레이한 다음 내보내세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is nog geen opslag voor deze game. Speel hem één keer en exporteer dan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este jogo ainda não tem save. Jogue uma vez e depois exporte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этой игры пока нет сохранения. Сыграйте один раз, затем экспортируйте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这款游戏尚无存档。请先玩一次，然后再导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這款遊戲尚無存檔。請先玩一次，然後再匯出。"
          }
        }
      }
    },
    "These are independent projects, listed for information. EspressU doesn't host them, and there's no server address built in for them: import the network_services.xml their host gives you.\n\nPretendo Network is built in under Network Service, but it needs a Wii U's account and console files." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind unabhängige Projekte, zur Information aufgelistet. EspressU hostet sie nicht, und für sie ist keine Serveradresse eingebaut: Importiere die network_services.xml, die ihr Host dir gibt.\n\nPretendo Network ist unter Netzwerkdienst eingebaut, braucht aber das Konto und die Konsolendateien einer Wii U."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son proyectos independientes, listados solo a título informativo. EspressU no los aloja y no hay dirección de servidor integrada para ellos: importa el network_services.xml que te dé su anfitrión.\n\nPretendo Network está integrado en Servicio de red, pero necesita la cuenta y los archivos de consola de una Wii U."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce sont des projets indépendants, listés à titre d'information. EspressU ne les héberge pas, et aucune adresse de serveur n'est intégrée pour eux : importez le network_services.xml que leur hôte vous donne.\n\nPretendo Network est intégré sous Service réseau, mais il nécessite le compte et les fichiers de console d'une Wii U."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono progetti indipendenti, elencati a scopo informativo. EspressU non li ospita e non ha un indirizzo server integrato per essi: importa il network_services.xml che ti fornisce il loro gestore.\n\nPretendo Network è integrato in Servizio di rete, ma richiede l'account e i file di console di un Wii U."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらは独立したプロジェクトで、情報として掲載しています。EspressUはそれらをホストせず、サーバアドレスも内蔵していません。運営元から提供されたnetwork_services.xmlを読み込んでください。\n\nPretendo Networkはネットワークサービスに内蔵されていますが、Wii Uのアカウントとコンソールファイルが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "독립 프로젝트이며 참고용으로 나열했습니다. EspressU는 이들을 호스팅하지 않으며 내장된 서버 주소도 없습니다. 호스트가 제공하는 network_services.xml을 가져오세요.\n\nPretendo Network는 네트워크 서비스에 내장되어 있지만 Wii U의 계정과 콘솔 파일이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zijn onafhankelijke projecten, ter informatie vermeld. EspressU host ze niet en er is geen serveradres voor ze ingebouwd: importeer de network_services.xml die hun beheerder je geeft.\n\nPretendo Network is ingebouwd onder Netwerkservice, maar heeft het account en de consolebestanden van een Wii U nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São projetos independentes, listados só para informação. O EspressU não os hospeda e não há endereço de servidor embutido para eles: importe o network_services.xml que o responsável por eles fornecer.\n\nO Pretendo Network está embutido em Serviço de rede, mas precisa da conta e dos arquivos de console de um Wii U."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это независимые проекты, перечисленные для информации. EspressU не размещает их, и для них нет встроенного адреса сервера: импортируйте network_services.xml, который даст их хост.\n\nPretendo Network встроен в раздел «Сетевая служба», но ему нужны учётная запись и файлы консоли Wii U."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是独立项目，仅供参考列出。EspressU 不托管它们，也没有为它们内置服务器地址：请导入其运营方提供的 network_services.xml。\n\nPretendo Network 已内置在“网络服务”下，但它需要 Wii U 的账户和主机文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些是獨立專案，僅供參考列出。EspressU 不代管它們，也沒有為它們內建伺服器位址：請匯入其營運方提供的 network_services.xml。\n\nPretendo Network 已內建在「網路服務」下，但它需要 Wii U 的帳號和主機檔案。"
          }
        }
      }
    },
    "They were saved when you switched to Basic. Keep defaults forgets them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wurden gesichert, als du zu Einfach gewechselt hast. „Standard behalten“ verwirft sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardaron al pasar a Básico. «Mantener valores predeterminados» los olvida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils ont été enregistrés quand vous êtes passé en Basique. « Garder les valeurs par défaut » les oublie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono stati salvati quando sei passato a Base. «Mantieni predefiniti» li dimentica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「基本」に切り替えたときに保存されました。「初期設定のまま」にすると破棄されます。"
          }
