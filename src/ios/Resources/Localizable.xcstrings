    "Account %@ was imported, but it can't play online: %@. Link a PNID on the console first, then dump account.dat again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto %@ wurde importiert, kann aber nicht online spielen: %@. Verknüpfe zuerst eine PNID auf der Konsole und sichere dann die account.dat erneut."
          }
        },
        "es" : {
