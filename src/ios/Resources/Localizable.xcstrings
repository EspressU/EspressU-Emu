    "This clears every game's shaders. Games will stutter while they rebuild them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das löscht die Shader aller Spiele. Spiele ruckeln, während sie sie neu aufbauen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borra los shaders de todos los juegos. Los juegos irán a tirones mientras los reconstruyen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela efface les shaders de tous les jeux. Les jeux saccaderont le temps de les reconstruire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo cancella gli shader di ogni gioco. I giochi scatteranno mentre li ricostruiscono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのゲームのシェーダを消去します。再構築する間、ゲームがカクつきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 게임의 셰이더가 지워집니다. 다시 만드는 동안 게임이 끊깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit wist de shaders van elke game. Games haperen terwijl ze ze opnieuw opbouwen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto apaga os shaders de todos os jogos. Os jogos vão engasgar enquanto os recriam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это очищает шейдеры всех игр. Игры будут подтормаживать, пока их пересоздают."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会清除所有游戏的着色器。游戏在重新构建它们期间会卡顿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會清除所有遊戲的著色器。遊戲在重新建置它們期間會卡頓。"
          }
        }
      }
    },
    "This content is for a different game or region than the one you picked." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Inhalt gehört zu einem anderen Spiel oder einer anderen Region als der gewählten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este contenido es de otro juego o región distinta a la que elegiste."
          }
