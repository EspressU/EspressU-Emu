    "The device has cooled down. The game should run at full speed again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät ist abgekühlt. Das Spiel sollte wieder mit voller Geschwindigkeit laufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo se ha enfriado. El juego debería volver a ir a toda velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appareil a refroidi. Le jeu devrait de nouveau tourner à pleine vitesse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo si è raffreddato. Il gioco dovrebbe tornare a piena velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスが冷えました。ゲームは再びフルスピードで動作するはずです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기가 식었습니다. 게임이 다시 최대 속도로 실행될 것입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat is afgekoeld. De game zou weer op volle snelheid moeten draaien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo esfriou. O jogo deve voltar a rodar na velocidade máxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство остыло. Игра снова должна работать на полной скорости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备已降温。游戏应该会恢复全速运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置已降溫。遊戲應該會恢復全速執行。"
          }
        }
      }
    },
    "The device is hot, so iOS is slowing the game down. After you quit, try Cool down automatically (Settings, CPU) or a lower Resolution (Settings, Graphics)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät ist heiß, deshalb bremst iOS das Spiel. Probiere nach dem Beenden „Automatisch abkühlen“ (Einstellungen, CPU) oder eine niedrigere Auflösung (Einstellungen, Grafik)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo está caliente, así que iOS está ralentizando el juego. Después de salir, prueba Enfriar automáticamente (Ajustes, CPU) o una resolución más baja (Ajustes, Gráficos)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appareil est chaud, donc iOS ralentit le jeu. Après avoir quitté, essayez le refroidissement automatique (Réglages, CPU) ou une résolution plus basse (Réglages, Graphismes)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo è caldo, quindi iOS sta rallentando il gioco. Dopo l'uscita, prova Raffredda automaticamente (Impostazioni, CPU) o una risoluzione più bassa (Impostazioni, Grafica)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスが高温のため、iOS がゲームの速度を落としています。終了後、「自動で冷却」(設定、CPU)または低い解像度(設定、グラフィック)をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기가 뜨거워서 iOS가 게임 속도를 낮추고 있습니다. 종료한 후 자동으로 식히기(설정, CPU)나 더 낮은 해상도(설정, 그래픽)를 시도해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat is heet, dus iOS vertraagt de game. Probeer na het afsluiten Automatisch afkoelen (Instellingen, CPU) of een lagere resolutie (Instellingen, Graphics)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo está quente, então o iOS está deixando o jogo mais lento. Depois de sair, tente Resfriar automaticamente (Ajustes, CPU) ou uma resolução menor (Ajustes, Gráficos)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство горячее, поэтому iOS замедляет игру. После выхода попробуйте «Охлаждать автоматически» (Настройки, ЦП) или более низкое разрешение (Настройки, Графика)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备很热，所以 iOS 正在降低游戏速度。退出后，请尝试“自动降温”（设置，CPU）或较低的分辨率（设置，图形）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置很熱，所以 iOS 正在降低遊戲速度。退出後，請嘗試「自動降溫」（設定，CPU）或較低的解析度（設定，圖形）。"
          }
        }
      }
    },
    "The drive or folder holding \"%@\" was disconnected. Connect it again, then start the game again. Your progress up to your last save is kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Laufwerk oder der Ordner mit „%@“ wurde getrennt. Verbinde es erneut und starte das Spiel dann neu. Dein Fortschritt bis zum letzten Speichern bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desconectó la unidad o carpeta que contiene «%@». Vuelve a conectarla y luego inicia el juego de nuevo. Se conserva tu progreso hasta la última partida guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque ou le dossier contenant « %@ » a été déconnecté. Reconnectez-le, puis relancez le jeu. Votre progression jusqu'à votre dernière sauvegarde est conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'unità o la cartella che contiene «%@» è stata scollegata. Ricollegala, poi riavvia il gioco. I progressi fino all'ultimo salvataggio vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」が入っているドライブまたはフォルダの接続が切れました。もう一度接続してから、ゲームを起動し直してください。最後のセーブまでの進行状況は保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"이(가) 들어 있는 드라이브 또는 폴더의 연결이 끊어졌습니다. 다시 연결한 다음 게임을 다시 시작하세요. 마지막 저장까지의 진행 상황은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De schijf of map met «%@» is losgekoppeld. Sluit hem opnieuw aan en start de game opnieuw. Je voortgang tot je laatste opslag blijft behouden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A unidade ou pasta que guarda «%@» foi desconectada. Conecte de novo e inicie o jogo outra vez. Seu progresso até o último save é mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск или папка, где лежит «%@», отключены. Подключите их снова, затем запустите игру ещё раз. Ваш прогресс до последнего сохранения сохраняется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存放“%@”的磁盘或文件夹已断开连接。请重新连接，然后再次启动游戏。你到上次存档为止的进度会保留。"
