          }
        }
      }
    },
    "Slows the clock by itself when a game doesn't start drawing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bremst die Uhr selbst, wenn ein Spiel nicht zu zeichnen beginnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce el reloj por sí mismo cuando un juego no empieza a dibujar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentit l'horloge tout seul quand un jeu ne commence pas à dessiner."
          }
        },
        "it" : {
          "stringUnit" : {
