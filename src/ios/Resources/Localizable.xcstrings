    "This device doesn't support mesh shaders, so some graphic packs may not render correctly. See Graphic Packs under Library." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät unterstützt keine Mesh-Shader, daher werden manche Grafikpacks eventuell falsch dargestellt. Siehe Grafikpacks unter Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no admite mesh shaders, por lo que algunos packs gráficos pueden no verse bien. Consulta Packs gráficos en Biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne prend pas en charge les mesh shaders, donc certains packs graphiques peuvent mal s'afficher. Voir Packs graphiques sous Bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non supporta i mesh shader, quindi alcuni pack grafici potrebbero non essere visualizzati correttamente. Vedi Pack grafici in Libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはメッシュシェーダに対応していないため、一部のグラフィックパックが正しく描画されない場合があります。ライブラリのグラフィックパックを参照してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 메시 셰이더를 지원하지 않으므로 일부 그래픽 팩이 올바르게 표시되지 않을 수 있습니다. 라이브러리의 그래픽 팩을 참조하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat ondersteunt geen mesh shaders, dus sommige grafische packs worden mogelijk niet goed weergegeven. Zie Grafische packs onder Bibliotheek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não é compatível com mesh shaders, então alguns pacotes gráficos podem não aparecer corretamente. Veja Pacotes gráficos em Biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство не поддерживает mesh-шейдеры, поэтому некоторые графические паки могут отображаться неправильно. См. «Графические паки» в «Библиотеке»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备不支持网格着色器，因此某些图形包可能无法正确渲染。请参阅“游戏库”下的“图形包”。"
          }
        },
