    "One core. Cooler, and often faster on devices without spare performance cores." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kern. Kühler und auf Geräten ohne freie Performance-Kerne oft schneller."
