    "Even frames at the game's own speed, never faster." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleichmäßige Frames in der Eigengeschwindigkeit des Spiels, nie schneller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotogramas regulares a la velocidad propia del juego, nunca más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images régulières à la vitesse propre du jeu, jamais plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotogrammi regolari alla velocità propria del gioco, mai più veloci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム本来の速度で均等なフレームを出し、それより速くなることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 자체 속도로 고른 프레임을 보여 주며 그보다 빨라지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelijkmatige frames op de eigen snelheid van de game, nooit sneller."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadros regulares na velocidade do próprio jogo, nunca mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ровные кадры с собственной скоростью игры, никогда не быстрее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以游戏自身的速度均匀输出帧，绝不更快。"
          }
        },
