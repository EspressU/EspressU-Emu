    "Never flickers. A short hitch the first time a new effect appears." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flackert nie. Ein kurzer Ruckler, wenn ein neuer Effekt zum ersten Mal erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca parpadea. Un pequeño tirón la primera vez que aparece un efecto nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne scintille jamais. Un bref accroc la première fois qu'un nouvel effet apparaît."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sfarfalla mai. Una breve esitazione la prima volta che compare un nuovo effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ちらつきません。新しいエフェクトが初めて出るとき、一瞬カクつきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깜빡이지 않습니다. 새 효과가 처음 나타날 때 잠깐 끊깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flikkert nooit. Een korte hapering de eerste keer dat een nieuw effect verschijnt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca pisca. Um pequeno engasgo na primeira vez que um efeito novo aparece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не мерцает. Короткая заминка при первом появлении нового эффекта."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不闪烁。新效果首次出现时会有短暂卡顿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕不閃爍。新效果首次出現時會有短暫卡頓。"
          }
        }
      }
    },
    "Never freezes. A new effect can be missing for a moment the first time." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friert nie ein. Ein neuer Effekt kann beim ersten Mal kurz fehlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca se congela. Un efecto nuevo puede faltar un momento la primera vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne se fige jamais. Un nouvel effet peut manquer un instant la première fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si blocca mai. Un nuovo effetto può mancare per un attimo la prima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固まりません。新しいエフェクトは初回に一瞬表示されないことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멈추지 않습니다. 새 효과는 처음에 잠깐 보이지 않을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevriest nooit. Een nieuw effect kan de eerste keer even ontbreken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca trava. Um efeito novo pode faltar por um instante na primeira vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не зависает. Новый эффект при первом появлении может ненадолго пропасть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不卡死。新效果首次出现时可能会短暂缺失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕不凍結。新效果首次出現時可能會短暫缺失。"
          }
        }
      }
    },
