    "Sets your screen to full brightness during a game and puts it back afterwards." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt den Bildschirm während eines Spiels auf volle Helligkeit und setzt ihn danach zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone la pantalla al máximo brillo durante un juego y la deja como estaba después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met votre écran à pleine luminosité pendant un jeu et le remet ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta lo schermo alla massima luminosità durante un gioco e poi lo ripristina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム中は画面を最大の明るさにし、終わると元に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 중에는 화면을 최대 밝기로 설정하고 끝나면 되돌립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet je scherm tijdens een game op volle helderheid en zet het daarna terug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa a tela no brilho máximo durante um jogo e a devolve ao normal depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливает максимальную яркость экрана на время игры и возвращает прежнюю после."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
