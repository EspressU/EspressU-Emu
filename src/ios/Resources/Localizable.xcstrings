    "What moves the GamePad's gyro. Automatic uses a connected controller, otherwise this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was das Gyro des GamePads bewegt. Automatisch nutzt einen verbundenen Controller, sonst dieses Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué mueve el giroscopio del GamePad. Automático usa un mando conectado y, si no, este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui fait bouger le gyroscope du GamePad. Automatique utilise une manette connectée, sinon cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa muove il giroscopio del GamePad. Automatico usa un controller connesso, altrimenti questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GamePadのジャイロを動かすもの。「自動」は接続したコントローラを使い、なければこのデバイスを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GamePad의 자이로를 움직이는 것. '자동'은 연결된 컨트롤러를 사용하고, 없으면 이 기기를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat de gyro van de GamePad beweegt. Automatisch gebruikt een verbonden controller, anders dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que move o giroscópio do GamePad. Automático usa um controle conectado e, senão, este dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что двигает гироскоп GamePad. «Автоматически» использует подключённый контроллер, иначе это устройство."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由什么驱动 GamePad 的陀螺仪。“自动”使用已连接的手柄，否则使用此设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由什麼驅動 GamePad 的陀螺儀。「自動」使用已連接的控制器，否則使用此裝置。"
          }
        }
