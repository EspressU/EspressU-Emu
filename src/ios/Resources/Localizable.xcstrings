    "As fast as possible: a softer picture, rougher lighting in some games, and shaders that may pop in." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So schnell wie möglich: ein weicheres Bild, gröbere Beleuchtung in manchen Spielen und Shader, die plötzlich auftauchen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo más rápido posible: imagen más suave, iluminación más tosca en algunos juegos y shaders que pueden aparecer de golpe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus rapide possible : image plus douce, éclairage plus grossier dans certains jeux et shaders pouvant apparaître d'un coup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il più veloce possibile: immagine più morbida, illuminazione più grezza in alcuni giochi e shader che possono comparire all'improvviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "できるだけ高速に: 映像はやわらかくなり、一部のゲームでライティングが粗くなり、シェーダーが突然現れることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대한 빠르게: 화면이 더 부드러워지고, 일부 게임에서 조명이 거칠어지며, 셰이더가 갑자기 나타날 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zo snel mogelijk: een zachter beeld, ruwere belichting in sommige games en shaders die plotseling kunnen verschijnen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mais rápido possível: imagem mais suave, iluminação mais grosseira em alguns jogos e shaders que podem surgir de repente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимально быстро: более мягкая картинка, более грубое освещение в некоторых играх и шейдеры, которые могут появляться внезапно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽可能快：画面更柔和，部分游戏光照更粗糙，着色器可能会突然出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儘可能快：畫面更柔和，部分遊戲光照更粗糙，著色器可能會突然出現。"
          }
        }
      }
    },
