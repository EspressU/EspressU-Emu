    "Slightly softer than Native, noticeably cheaper to draw." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas weicher als Nativ, spürbar günstiger zu zeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco más suave que Nativa, claramente más barata de dibujar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un peu plus doux que Natif, nettement moins coûteux à dessiner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggermente più morbida di Nativa, sensibilmente più economica da disegnare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ネイティブ」よりわずかにやわらかく、描画の負荷は明らかに軽くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'네이티브'보다 약간 부드럽고 그리기 부담이 확연히 적습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets zachter dan Native, merkbaar goedkoper om te tekenen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pouco mais suave que Nativa, bem mais barata de desenhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чуть мягче «Родного», заметно дешевле в отрисовке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比“原生”略柔和，绘制开销明显更低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比「原生」略柔和，繪製開銷明顯更低。"
          }
        }
      }
    },
    "Slower but more accurate: one CPU core and stricter GPU syncing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsamer, aber genauer: ein CPU-Kern und strengere GPU-Synchronisierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más lento pero más preciso: un núcleo de CPU y sincronización de GPU más estricta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus lent mais plus précis : un cœur CPU et une synchronisation GPU plus stricte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più lento ma più preciso: un core CPU e sincronizzazione GPU più rigorosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅くなりますが、より正確：CPUコア1つと、より厳密なGPU同期。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 느리지만 더 정확합니다: CPU 코어 1개와 더 엄격한 GPU 동기화."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trager maar nauwkeuriger: één CPU-kern en strengere GPU-synchronisatie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais lento, porém mais preciso: um núcleo da CPU e sincronização de GPU mais rígida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленнее, но точнее: одно ядро ЦП и более строгая синхронизация ГП."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更慢但更精确：一个 CPU 核心和更严格的 GPU 同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更慢但更精確：一個 CPU 核心和更嚴格的 GPU 同步。"
          }
        }
      }
    },
    "Slower but more accurate: one CPU core and stricter GPU syncing. Can fix a game that glitches or crashes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsamer, aber genauer: ein CPU-Kern und strengere GPU-Synchronisierung. Kann ein Spiel reparieren, das Fehler macht oder abstürzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más lento pero más preciso: un núcleo de CPU y sincronización de GPU más estricta. Puede arreglar un juego que da fallos o se cierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus lent mais plus précis : un cœur CPU et une synchronisation GPU plus stricte. Peut réparer un jeu qui bugue ou plante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più lento ma più preciso: un core CPU e sincronizzazione GPU più rigorosa. Può correggere un gioco che ha glitch o si chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅くなりますが、より正確：CPUコア1つと、より厳密なGPU同期。不具合やクラッシュが起きるゲームが直る場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 느리지만 더 정확합니다: CPU 코어 1개와 더 엄격한 GPU 동기화. 오류가 나거나 충돌하는 게임을 고칠 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trager maar nauwkeuriger: één CPU-kern en strengere GPU-synchronisatie. Kan een game repareren die haperingen vertoont of crasht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais lento, porém mais preciso: um núcleo da CPU e sincronização de GPU mais rígida. Pode consertar um jogo que apresenta falhas ou trava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленнее, но точнее: одно ядро ЦП и более строгая синхронизация ГП. Может исправить игру, которая глючит или вылетает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更慢但更精确：一个 CPU 核心和更严格的 GPU 同步。可以修复出现故障或崩溃的游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更慢但更精確：一個 CPU 核心和更嚴格的 GPU 同步。可以修正出現異常或當機的遊戲。"
          }
        }
      }
    },
    "Slows the clock by itself when a game doesn't start drawing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bremst die Uhr selbst, wenn ein Spiel nicht zu zeichnen beginnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce el reloj por sí mismo cuando un juego no empieza a dibujar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentit l'horloge tout seul quand un jeu ne commence pas à dessiner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rallenta da solo il clock quando un gioco non inizia a disegnare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームが描画を始めないとき、自動でクロックを遅くします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임이 그리기를 시작하지 않으면 클럭을 스스로 늦춥니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraagt de klok zelf als een game niet begint te tekenen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz o relógio por conta própria quando um jogo não começa a desenhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сам замедляет часы, если игра не начинает рисовать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当游戏没有开始绘制时，自动降低时钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當遊戲沒有開始繪製時，自動降低時脈。"
          }
        }
      }
    },
    "Slows the game a little. Try this first if a game runs but stutters." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bremst das Spiel ein wenig. Probiere das zuerst, wenn ein Spiel läuft, aber ruckelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentiza un poco el juego. Prueba esto primero si un juego funciona pero va a tirones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentit un peu le jeu. Essayez ceci en premier si un jeu tourne mais saccade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rallenta un po' il gioco. Prova prima questo se un gioco funziona ma scatta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームが少し遅くなります。ゲームは動くのにカクつく場合は、まずこれを試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임이 약간 느려집니다. 게임이 실행되지만 끊긴다면 먼저 이것을 시도해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraagt de game een beetje. Probeer dit eerst als een game draait maar hapert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa o jogo um pouco mais lento. Tente isto primeiro se um jogo roda mas engasga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немного замедляет игру. Попробуйте сначала это, если игра идёт, но подтормаживает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会让游戏稍微变慢。如果游戏能运行但卡顿，请先试试这个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會讓遊戲稍微變慢。如果遊戲能執行但卡頓，請先試試這個。"
          }
        }
      }
    },
    "Slows the game a lot. Helps most games under the interpreter." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bremst das Spiel stark. Hilft den meisten Spielen mit dem Interpreter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentiza mucho el juego. Ayuda a la mayoría de los juegos con el intérprete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentit beaucoup le jeu. Aide la plupart des jeux sous l'interpréteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rallenta molto il gioco. Aiuta la maggior parte dei giochi con l'interprete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームがかなり遅くなります。インタープリタで動かすほとんどのゲームに有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임이 많이 느려집니다. 인터프리터에서 대부분의 게임에 도움이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraagt de game flink. Helpt de meeste games onder de interpreter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa o jogo bem mais lento. Ajuda a maioria dos jogos com o interpretador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильно замедляет игру. Помогает большинству игр с интерпретатором."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会让游戏明显变慢。对大多数使用解释器的游戏有帮助。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會讓遊戲明顯變慢。對大多數使用直譯器的遊戲有幫助。"
          }
        }
      }
    },
    "Softest, coolest, longest-running. Use it when a game won't hold its frame rate." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am weichsten, am kühlsten, am längsten durchhaltend. Nutze es, wenn ein Spiel die Bildrate nicht hält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La más suave, fresca y duradera. Úsala cuando un juego no mantiene su tasa de fotogramas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus doux, le plus frais, le plus endurant. À utiliser quand un jeu ne tient pas sa fréquence d'images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La più morbida, fresca e duratura. Usala quando un gioco non mantiene il suo frame rate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最もやわらかく、最も低発熱で、最も長持ち。ゲームがフレームレートを保てないときに使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 부드럽고, 가장 시원하며, 가장 오래갑니다. 게임이 프레임 속도를 유지하지 못할 때 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachtst, koelst, langst. Gebruik dit als een game zijn framerate niet haalt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mais suave, fria e duradoura. Use quando um jogo não segura a taxa de quadros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самая мягкая, прохладная и долгая. Используйте, когда игра не держит частоту кадров."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最柔和、最凉爽、最持久。当游戏无法保持帧率时使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最柔和、最涼爽、最持久。當遊戲無法維持影格率時使用。"
          }
        }
      }
    },
    "Some files couldn't be read, so no .wua was made." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Dateien konnten nicht gelesen werden, daher wurde keine .wua erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer algunos archivos, así que no se creó ningún .wua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains fichiers n'ont pas pu être lus, aucun .wua n'a donc été créé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni file non sono stati letti, quindi non è stato creato nessun .wua."
          }
        },
        "ja" : {
