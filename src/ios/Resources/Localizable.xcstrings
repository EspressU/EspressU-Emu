        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕點「匯入遊戲」，或把遊戲檔案放進 檔案 > 我的 iPad > EspressU > Roms。"
          }
        }
      }
    },
    "Tap or swipe down at the top edge to bring the bar back." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe oben am Rand oder wische nach unten, um die Leiste zurückzuholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca o desliza hacia abajo en el borde superior para recuperar la barra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez ou balayez vers le bas au bord supérieur pour faire revenir la barre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca o scorri verso il basso sul bordo superiore per far tornare la barra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上端をタップするか下にスワイプすると、バーが戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상단 가장자리를 탭하거나 아래로 쓸어내리면 막대가 다시 나타납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik of veeg aan de bovenrand omlaag om de balk terug te halen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque ou deslize para baixo na borda superior para trazer a barra de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите или проведите вниз у верхнего края, чтобы вернуть панель."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点顶部边缘或向下轻扫，即可让栏重新出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕點頂部邊緣或向下輕掃，即可讓欄重新出現。"
          }
        }
      }
    },
    "Tap Pair. A pairing file from iLoader works too: Settings › JIT." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
