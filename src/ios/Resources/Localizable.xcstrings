    "%@ is now the active Custom server. Pick Custom under Network Service to use it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist jetzt der aktive eigene Server. Wähle unter Netzwerkdienst „Eigen“, um ihn zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
