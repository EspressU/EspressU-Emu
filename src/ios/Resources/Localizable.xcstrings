    "Add a shader cache from desktop Cemu or another EspressU, so this game starts with its shaders already learned." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Shader-Cache aus dem Desktop-Cemu oder einem anderen EspressU hinzu, damit dieses Spiel mit bereits gelernten Shadern startet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una caché de shaders de Cemu de escritorio o de otro EspressU, para que este juego arranque con sus shaders ya aprendidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un cache de shaders de Cemu sur ordinateur ou d'un autre EspressU, pour que ce jeu démarre avec ses shaders déjà appris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una cache degli shader da Cemu desktop o da un altro EspressU, così questo gioco parte con gli shader già appresi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップ版 Cemu または別の EspressU からシェーダーキャッシュを追加すると、このゲームは学習済みのシェーダーを使って起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데스크톱 Cemu 또는 다른 EspressU의 셰이더 캐시를 추가하면 이 게임이 이미 학습된 셰이더로 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een shadercache toe van desktop-Cemu of een andere EspressU, zodat deze game start met shaders die al zijn geleerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um cache de shaders do Cemu para desktop ou de outro EspressU, para que este jogo inicie com os shaders já aprendidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте кэш шейдеров из настольного Cemu или другого EspressU, чтобы эта игра запускалась с уже изученными шейдерами."
          }
        },
        "zh-Hans" : {
