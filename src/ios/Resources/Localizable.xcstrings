          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts kunnen niet worden gewijzigd terwijl een game draait."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas não podem ser alteradas enquanto um jogo está em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учётные записи нельзя менять, пока запущена игра."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
