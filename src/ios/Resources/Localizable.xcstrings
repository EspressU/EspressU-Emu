          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reemplaza la partida guardada actual de %@. La que tienes ahora se copia primero, y el juego debe estar cerrado antes de hacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela remplace la sauvegarde actuelle de %@. Celle que vous avez maintenant est d'abord sauvegardée, et le jeu doit être fermé avant de le faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo sostituisce il salvataggio attuale di %@. Quello che hai ora viene prima salvato in un backup, e il gioco dovrebbe essere chiuso prima di farlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の現在のセーブデータを置き換えます。今あるものは先にバックアップされます。実行する前にゲームを閉じておいてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 현재 저장 데이터를 대체합니다. 지금 가지고 있는 것은 먼저 백업되며, 이 작업 전에 게임을 종료해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit vervangt de huidige opslag van %@. De opslag die je nu hebt wordt eerst als back-up bewaard, en de game moet gesloten zijn voordat je dit doet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto substitui o save atual de %@. O que você tem agora é copiado antes, e o jogo deve estar fechado antes de fazer isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это заменит текущее сохранение %@. Текущее сначала копируется, и перед этим игру нужно закрыть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会替换%@当前的存档。你现有的存档会先备份，并且操作前应先关闭游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
