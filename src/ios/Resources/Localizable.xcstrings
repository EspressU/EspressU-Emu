          }
        }
      }
    },
    "This folder is missing title.tik (the ticket), which EspressU needs to decrypt it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Ordner fehlt die title.tik (das Ticket), die EspressU zum Entschlüsseln braucht."
          }
        },
        "es" : {
