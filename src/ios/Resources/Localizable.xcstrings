    "What every game has saved so it starts faster." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was jedes Spiel gespeichert hat, damit es schneller startet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que cada juego ha guardado para iniciarse más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que chaque jeu a enregistré pour démarrer plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che ogni gioco ha salvato per avviarsi più in fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ゲームが高速に起動するために保存したもの。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 게임이 더 빨리 시작되도록 저장해 둔 것."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat elke game heeft bewaard om sneller te starten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que cada jogo salvou para iniciar mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что сохранила каждая игра, чтобы запускаться быстрее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每款游戏为加快启动而保存的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每款遊戲為加快啟動而儲存的內容。"
          }
        }
      }
    },
    "What every game has saved so it starts faster. To clear one game, open its options. Clearing needs the game closed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was jedes Spiel gespeichert hat, damit es schneller startet. Um ein einzelnes Spiel zu leeren, öffne seine Optionen. Zum Leeren muss das Spiel beendet sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que ha guardado cada juego para arrancar más rápido. Para vaciar un solo juego, abre sus opciones. Para vaciar, el juego debe estar cerrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que chaque jeu a enregistré pour démarrer plus vite. Pour vider un seul jeu, ouvrez ses options. Le jeu doit être fermé pour vider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che ogni gioco ha salvato per partire più velocemente. Per svuotare un solo gioco, apri le sue opzioni. Per svuotare il gioco deve essere chiuso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ゲームが、より速く起動するために保存したもの。1つのゲームだけ消去するには、そのオプションを開いてください。消去にはゲームを終了している必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 게임이 더 빠르게 시작하려고 저장한 데이터입니다. 한 게임만 지우려면 해당 게임의 옵션을 여세요. 지우려면 게임이 종료되어 있어야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat elke game heeft opgeslagen om sneller te starten. Om één game te legen, open je de opties ervan. Om te legen moet de game gesloten zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que cada jogo salvou para iniciar mais rápido. Para limpar um só jogo, abra as opções dele. Para limpar, o jogo precisa estar fechado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что каждая игра сохранила, чтобы запускаться быстрее. Чтобы очистить одну игру, откройте её параметры. Для очистки игра должна быть закрыта."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每款游戏为加快启动而保存的内容。若只清除一款游戏，请打开它的选项。清除时游戏必须已关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每款遊戲為加快啟動而儲存的內容。若只清除一款遊戲，請開啟它的選項。清除時遊戲必須已關閉。"
          }
        }
      }
    },
