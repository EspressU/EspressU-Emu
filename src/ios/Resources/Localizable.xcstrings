    "Low Power Mode is on, so games may run slowly. Turn it off in Control Centre for full speed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Stromsparmodus ist an, deshalb laufen Spiele eventuell langsam. Schalte ihn im Kontrollzentrum aus, um volle Geschwindigkeit zu bekommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de bajo consumo está activado, así que los juegos pueden ir lentos. Desactívalo en el Centro de control para tener la máxima velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode économie d'énergie est activé, les jeux risquent donc de ramer. Désactivez-le dans le Centre de contrôle pour une vitesse maximale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità Risparmio energetico è attiva, quindi i giochi potrebbero andare lenti. Disattivala nel Centro di Controllo per la massima velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低電力モードがオンのため、ゲームが遅くなる場合があります。フルスピードにするにはコントロールセンターでオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저전력 모드가 켜져 있어 게임이 느릴 수 있습니다. 최대 속도를 원하면 제어 센터에서 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Batterijbesparing staat aan, dus games kunnen traag draaien. Zet hem uit in het Bedieningscentrum voor volle snelheid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Modo de Baixo Consumo está ativado, então os jogos podem rodar devagar. Desative-o na Central de Controle para ter velocidade máxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включён режим энергосбережения, поэтому игры могут тормозить. Выключите его в Пункте управления для полной скорости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
