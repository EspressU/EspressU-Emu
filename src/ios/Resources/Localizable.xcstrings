        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они были сохранены, когда вы переключились на «Базовый». «Оставить по умолчанию» их забывает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们是你切换到“基础”时保存的。“保持默认”会将其丢弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它們是你切換到「基本」時儲存的。「保持預設」會將其捨棄。"
          }
        }
      }
    },
