    "Only for encrypted games (.wud, .wux). Keys from your own Wii U, one per line. New keys apply to the next game you start." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für verschlüsselte Spiele (.wud, .wux). Schlüssel von deiner eigenen Wii U, einer pro Zeile. Neue Schlüssel gelten ab dem nächsten Spielstart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo para juegos cifrados (.wud, .wux). Claves de tu propia Wii U, una por línea. Las claves nuevas se aplican al siguiente juego que inicies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement pour les jeux chiffrés (.wud, .wux). Clés de votre propre Wii U, une par ligne. Les nouvelles clés s'appliquent au prochain jeu lancé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo per giochi cifrati (.wud, .wux). Chiavi del tuo Wii U, una per riga. Le nuove chiavi si applicano al prossimo gioco che avvii."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されたゲーム（.wud、.wux）専用です。ご自身のWii Uのキーを1行に1つ。新しいキーは次に起動するゲームから反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화된 게임(.wud, .wux) 전용입니다. 본인 Wii U의 키를 한 줄에 하나씩. 새 키는 다음에 시작하는 게임부터 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen voor versleutelde games (.wud, .wux). Sleutels van je eigen Wii U, één per regel. Nieuwe sleutels gelden voor de volgende game die je start."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só para jogos criptografados (.wud, .wux). Chaves do seu próprio Wii U, uma por linha. As chaves novas valem para o próximo jogo que você iniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только для зашифрованных игр (.wud, .wux). Ключи с вашей Wii U, по одному в строке. Новые ключи применяются к следующей запущенной игре."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于加密游戏（.wud、.wux）。来自你自己 Wii U 的密钥，每行一个。新密钥对下次启动的游戏生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅用於加密遊戲（.wud、.wux）。來自你自己 Wii U 的金鑰，每行一個。新金鑰對下次啟動的遊戲生效。"
          }
        }
      }
    },
